# 火山引擎 Ark Key
# 单 key 兼容模式，和下面的 ARK_API_KEYS 二选一
ARK_API_KEY=
ARK_API_KEY_ID=default

# 推荐的多 key 格式：key_id:api_key,key_id:api_key
ARK_API_KEYS=
ARK_API_KEY_MAX_CONCURRENCY=1
ARK_API_KEY_DEFAULT_WEIGHT=1
ARK_API_KEY_COOLDOWN_SECONDS=120
JOB_WORKER_CONCURRENCY=4

ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
USE_MOCK_GENERATOR=false

# 生成器后端：seedream / nano_banana_pro / nano_banana_2 / sora_image
IMAGE_GENERATOR_BACKEND=seedream

# nano-banana-pro（API易）
NANO_BANANA_API_KEY=
NANO_BANANA_BASE_URL=https://api.apiyi.com
NANO_BANANA_MODEL=gemini-3-pro-image-preview

# nano-banana-2（API易）
NANO_BANANA_2_API_KEY=
NANO_BANANA_2_BASE_URL=https://api.apiyi.com
NANO_BANANA_2_MODEL=gemini-3.1-flash-image-preview

# sora-image（API易）
SORA_IMAGE_API_KEY=
SORA_IMAGE_BASE_URL=https://api.apiyi.com/v1
SORA_IMAGE_MODEL=sora_image

# 图片理解模型（API易 Gemini 3 Pro Preview）
IMAGE_UNDERSTANDING_API_KEY=
IMAGE_UNDERSTANDING_BASE_URL=https://api.apiyi.com/v1
IMAGE_UNDERSTANDING_MODEL=gemini-3-pro-preview
IMAGE_UNDERSTANDING_TIMEOUT_SECONDS=120

# 微信登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALLOW_DEV_LOGIN=true

# 上传校验
ENFORCE_FACE_DETECTION=true
MAX_UPLOAD_SIZE_MB=10
MEDIA_RETENTION_DAYS=7
API_TOKEN_TTL_HOURS=72
CORS_ALLOW_ORIGINS=*

# 生产推荐：PostgreSQL / MySQL + Redis + 独立 Worker + OSS
DATABASE_URL=postgresql+psycopg://aiface:password@127.0.0.1:5432/aiface
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=16
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

JOB_QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_KEY=aiface:jobs
RUN_EMBEDDED_WORKER=false

OBJECT_STORAGE_BACKEND=aliyun_oss
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=aiface

# 本地兼容模式示例
# 1. 把 DATABASE_URL 留空，启用 DATABASE_PATH
# 2. 把 JOB_QUEUE_BACKEND 改为 local，并开启 RUN_EMBEDDED_WORKER
# 3. 把 OBJECT_STORAGE_BACKEND 改为 local
STORAGE_DIR=/home/your-user/AIFace/storage
DATABASE_PATH=/home/your-user/AIFace/storage/app.db
