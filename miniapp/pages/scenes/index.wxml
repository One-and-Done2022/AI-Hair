<view class="screen selector-screen">
  <view class="selector-copy">
    <view class="section-kicker">02 / 场景</view>
    <view class="title selector-title">选择适合这款发型的场景</view>
    <view class="subtitle selector-subtitle">完成这一页后会回到首页。</view>
  </view>

  <view class="panel combo-card">
    <image
      wx:if="{{selectedHairstyle && selectedHairstyle.cover_url}}"
      class="combo-cover"
      src="{{selectedHairstyle.cover_url}}"
      mode="aspectFill"
      lazy-load="true"
    ></image>
    <view wx:else class="combo-cover"></view>
    <view class="combo-body">
      <view class="combo-label">当前发型</view>
      <view class="combo-title">{{selectedHairstyle ? selectedHairstyle.name : '未选择发型'}}</view>
      <view class="combo-meta">{{selectedHairstyle ? selectedHairstyle.style_line_label : '待选择'}}</view>
    </view>
    <view class="combo-link" bindtap="goBackStep">改发型</view>
  </view>

  <view class="sticky-toolbar">
    <view class="toolbar-shell">
      <scroll-view class="style-switch" scroll-x="true" enable-flex="true" show-scrollbar="false">
        <view
          wx:for="{{styleLineOptions}}"
          wx:key="id"
          class="style-chip {{selectedStyleLine === item.id ? 'active' : ''}}"
          bindtap="selectStyleLine"
          data-style-line="{{item.id}}"
        >
          {{item.label}}
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{selectedSceneName}}" class="panel current-pill-card">
    <view class="current-label">已选场景</view>
    <view class="current-value">{{selectedSceneName}}</view>
  </view>

  <view class="template-grid">
    <view
      wx:for="{{visibleScenes}}"
      wx:key="id"
      class="template-tile {{selectedSceneId === item.id ? 'selected' : ''}}"
      bindtap="selectScene"
      data-id="{{item.id}}"
    >
      <view class="tile-cover-shell">
        <image
          class="tile-cover"
          src="{{item.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:if="{{item.recommended}}" class="recommended-badge">推荐</view>
        <view wx:if="{{selectedSceneId === item.id}}" class="selected-check">已选</view>
      </view>
      <view class="tile-name">{{item.name}}</view>
      <view class="tile-meta-row">
        <view class="tile-chip primary-chip">{{item.style_line_label}}</view>
        <view wx:if="{{item.primaryTag}}" class="tile-note">{{item.primaryTag}}</view>
      </view>
    </view>
  </view>

  <view class="save-bar">
    <button class="primary-button save-button" bindtap="saveSelection">完成选择</button>
  </view>
</view>
