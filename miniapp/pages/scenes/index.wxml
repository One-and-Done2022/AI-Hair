<view class="screen scene-screen">
  <view class="flow-nav">
    <view class="flow-nav-group">
      <view class="flow-nav-button" bindtap="goBackStep">上一步</view>
      <view class="flow-nav-button" bindtap="resetFlow">回首页</view>
    </view>
    <view class="flow-nav-caption">定好场景后再选参数</view>
  </view>

  <view class="progress-shell">
    <view class="progress-top">
      <view class="progress-step-text">第二步 / 共四步</view>
      <view class="progress-percent">50%</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill progress-fill-half"></view>
    </view>
  </view>

  <view class="editorial-head">
    <view class="title editorial-title">选择场景</view>
    <view class="subtitle editorial-subtitle">场景只负责氛围、光线和服饰，不改你的已选发型。</view>
  </view>

  <view class="panel combo-card">
    <view wx:if="{{selectedHairstyle && selectedHairstyle.cover_url}}" class="combo-cover-stage">
      <image
        class="combo-cover combo-cover-hair"
        src="{{selectedHairstyle.cover_url}}"
        mode="aspectFill"
        lazy-load="true"
      ></image>
    </view>
    <view wx:else class="combo-cover"></view>
    <view class="combo-body">
      <view class="combo-label">当前发型</view>
      <view class="combo-title">{{selectedHairstyle ? selectedHairstyle.name : '未选择发型'}}</view>
      <view class="combo-meta">{{selectedHairstyleMeta || '继续挑一个合适场景'}}</view>
    </view>
  </view>

  <scroll-view class="style-switch" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view
      wx:for="{{styleLineOptions}}"
      wx:key="id"
      class="style-chip {{selectedStyleLine === item.id ? 'active' : ''}}"
      bindtap="selectStyleLine"
      data-style-line="{{item.id}}"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="scene-list">
    <view
      wx:for="{{visibleScenes}}"
      wx:key="id"
      class="scene-card {{selectedSceneId === item.id ? 'selected' : ''}}"
      bindtap="selectScene"
      data-id="{{item.id}}"
    >
      <view class="scene-cover-shell">
        <image
          class="scene-cover"
          src="{{item.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
          catchtap="previewScene"
          data-id="{{item.id}}"
        ></image>
        <view class="preview-pill" catchtap="previewScene" data-id="{{item.id}}">预览</view>
        <view class="scene-check {{selectedSceneId === item.id ? 'active' : ''}}">✓</view>
      </view>
      <view class="scene-body">
        <view class="scene-name">{{item.name}}</view>
        <view class="scene-desc">{{item.description}}</view>
        <view class="scene-chip-row">
          <view wx:if="{{item.style_line_label}}" class="scene-chip">{{item.style_line_label}}</view>
          <view wx:if="{{item.primaryTag}}" class="scene-chip">{{item.primaryTag}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="floating-bar">
    <button class="primary-button" bindtap="goNext">下一步，选参数</button>
  </view>
</view>
