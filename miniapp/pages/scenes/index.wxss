.scene-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.progress-fill-half {
  width: 50%;
}

.editorial-head {
  padding: 32rpx 4rpx 20rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 560rpx;
}

.combo-card {
  margin-top: 24rpx;
  padding: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.combo-cover {
  width: 124rpx;
  height: 154rpx;
  border-radius: 24rpx;
  background: #eff1f2;
  flex-shrink: 0;
}

.combo-cover-stage {
  position: relative;
  width: 124rpx;
  height: 154rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #ffffff;
}

.combo-cover-hair {
  background: #ffffff;
}

.combo-body {
  flex: 1;
  min-width: 0;
}

.combo-label {
  font-size: 21rpx;
  color: #5d6670;
}

.combo-title {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.combo-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.42;
  color: #4d5762;
}

.style-switch {
  margin-top: 24rpx;
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  color: #4d5762;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 88, 186, 0.04);
}

.style-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.scene-list {
  margin-top: 26rpx;
  display: grid;
  gap: 22rpx;
}

.scene-card {
  padding: 20rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.scene-card.selected {
  box-shadow: 0 0 0 4rpx rgba(11, 94, 207, 0.2), 0 18rpx 44rpx rgba(0, 88, 186, 0.08);
}

.scene-cover-shell {
  position: relative;
  border-radius: 26rpx;
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 560rpx;
  border-radius: 26rpx;
  display: block;
  background: #eff1f2;
}

.preview-pill {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
}

.scene-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(0, 88, 186, 0.86);
}

.scene-body {
  margin-top: 18rpx;
}

.scene-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scene-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: #4d5762;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
}

.scene-chip-row {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.scene-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eff1f7;
  color: #4d5762;
  font-size: 20rpx;
  font-weight: 700;
}
