.step-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #f0fdf4, #ecfeff);
}

.step-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(13, 148, 136, 0.12);
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.summary-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
}

.summary-label {
  color: #64748b;
  font-size: 24rpx;
}

.summary-value {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.summary-meta {
  margin-top: 10rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
}

.template-section {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.template-list {
  margin-top: 20rpx;
}

.template-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
}

.template-card.selected {
  border-color: #2563eb;
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.12);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.template-type.scene {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #15803d;
  font-size: 22rpx;
  font-weight: 700;
}

.mini-chip {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfccb;
  color: #3f6212;
  font-size: 22rpx;
  font-weight: 600;
}

.template-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.template-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.7;
}

.tag-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
}

.back-button {
  margin-top: 8rpx;
}

.save-button {
  margin-top: 18rpx;
  margin-bottom: 40rpx;
}
