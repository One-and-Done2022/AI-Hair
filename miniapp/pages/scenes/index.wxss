.scene-screen {
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-step-text {
  font-size: 20rpx;
  color: #757778;
}

.progress-percent {
  font-size: 30rpx;
  color: #0058ba;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #dadddf;
  overflow: hidden;
}

.progress-fill {
  width: 66%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0058ba 0%, #5091ff 100%);
}

.editorial-head {
  padding: 34rpx 4rpx 22rpx;
}

.editorial-subtitle {
  max-width: 560rpx;
}

.combo-card {
  padding: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.combo-cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  background: #eff1f2;
  flex-shrink: 0;
}

.combo-body {
  flex: 1;
  min-width: 0;
}

.combo-label {
  font-size: 21rpx;
  color: #757778;
}

.combo-title {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2c2f30;
}

.combo-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #595c5d;
}

.combo-link {
  color: #0058ba;
  font-size: 24rpx;
  font-weight: 700;
}

.style-switch {
  margin-top: 24rpx;
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #595c5d;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(0, 88, 186, 0.04);
}

.style-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.scene-list {
  margin-top: 26rpx;
  display: grid;
  gap: 22rpx;
}

.scene-card {
  padding: 18rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 44rpx rgba(0, 88, 186, 0.06);
}

.scene-card.selected {
  box-shadow: 0 0 0 3rpx #0058ba, 0 18rpx 44rpx rgba(0, 88, 186, 0.08);
}

.scene-cover-shell {
  position: relative;
}

.scene-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 22rpx;
  display: block;
  background: #eff1f2;
}

.scene-badge,
.scene-check {
  position: absolute;
  top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.scene-badge {
  left: 16rpx;
  background: rgba(0, 88, 186, 0.86);
}

.scene-check {
  right: 16rpx;
  background: rgba(0, 88, 186, 0.86);
}

.scene-body {
  margin-top: 18rpx;
}

.scene-name {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #2c2f30;
}

.scene-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #595c5d;
}

.scene-chip-row {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.scene-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eff1f7;
  color: #595c5d;
  font-size: 19rpx;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 18;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 249, 253, 0) 0%, rgba(248, 249, 253, 0.95) 28%, #f8f9fd 100%);
}
