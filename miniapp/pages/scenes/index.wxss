.selector-screen {
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.selector-copy {
  padding: 12rpx 8rpx 26rpx;
}

.selector-title {
  margin-top: 18rpx;
}

.selector-subtitle {
  max-width: 580rpx;
}

.combo-card {
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.combo-cover {
  width: 126rpx;
  height: 126rpx;
  border-radius: 22rpx;
  background: #eadfd9;
  flex-shrink: 0;
}

.combo-body {
  flex: 1;
  min-width: 0;
}

.combo-label {
  font-size: 22rpx;
  color: #a08679;
}

.combo-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #302520;
  line-height: 1.35;
}

.combo-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8d786d;
}

.combo-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9d6f63;
  font-weight: 700;
}

.sticky-toolbar {
  position: sticky;
  top: 18rpx;
  z-index: 6;
  margin-bottom: 20rpx;
}

.toolbar-shell {
  padding: 18rpx;
  border-radius: 32rpx;
  background: rgba(255, 250, 247, 0.92);
  box-shadow: 0 20rpx 52rpx rgba(86, 66, 57, 0.08);
}

.style-switch {
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fbf5f1;
  color: #8d786d;
  font-size: 23rpx;
  font-weight: 600;
}

.style-chip.active {
  background: #f1dfd8;
  color: #8a6158;
}

.current-pill-card {
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.current-label {
  font-size: 22rpx;
  color: #a08679;
}

.current-value {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #302520;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.template-tile {
  padding: 14rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 18rpx 42rpx rgba(86, 66, 57, 0.06);
}

.template-tile.selected {
  background: linear-gradient(180deg, #fffaf7 0%, #f7ebe4 100%);
  box-shadow: 0 20rpx 48rpx rgba(157, 111, 99, 0.14);
  transform: translateY(-4rpx);
}

.tile-cover-shell {
  position: relative;
}

.tile-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  display: block;
  background: #eadfd9;
}

.recommended-badge,
.selected-check {
  position: absolute;
  top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.recommended-badge {
  left: 16rpx;
  background: rgba(157, 111, 99, 0.86);
}

.selected-check {
  right: 16rpx;
  background: rgba(48, 37, 32, 0.74);
}

.tile-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #302520;
  line-height: 1.4;
}

.tile-meta-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-chip {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.primary-chip {
  background: #f3e2db;
  color: #9d6f63;
}

.tile-note {
  font-size: 21rpx;
  color: #8d786d;
}

.save-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 248, 244, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(86, 66, 57, 0.1);
}

.save-button {
  width: 100%;
}

@media (max-width: 360px) {
  .template-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
