.selector-screen {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.step-hero {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(circle at top right, rgba(187, 247, 208, 0.6), transparent 34%),
    linear-gradient(135deg, #ecfdf5, #f8fafc);
}

.step-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 148, 136, 0.12);
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.combo-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.combo-label {
  color: #64748b;
  font-size: 23rpx;
}

.combo-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.combo-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 22rpx;
  background: #dbe4f0;
  flex-shrink: 0;
}

.combo-body {
  flex: 1;
  min-width: 0;
}

.combo-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.combo-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #0f766e;
}

.combo-link {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.sticky-toolbar {
  position: sticky;
  top: 18rpx;
  z-index: 6;
  margin-bottom: 20rpx;
}

.toolbar-card {
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16rpx);
}

.toolbar-note {
  color: #475569;
  font-size: 24rpx;
}

.style-switch {
  margin-top: 16rpx;
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

.style-chip.active {
  background: #d1fae5;
  color: #047857;
}

.list-card {
  padding: 28rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.list-meta {
  color: #64748b;
  font-size: 23rpx;
}

.template-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.template-tile {
  overflow: hidden;
  border-radius: 26rpx;
  border: 2rpx solid transparent;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
}

.template-tile.selected {
  border-color: #0f766e;
  background: linear-gradient(135deg, #ecfdf5, #ffffff);
  box-shadow: 0 18rpx 44rpx rgba(15, 118, 110, 0.16);
}

.tile-cover-shell {
  position: relative;
}

.tile-cover {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #dbe4f0;
}

.recommended-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 118, 110, 0.86);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.selected-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.tile-body {
  padding: 18rpx;
}

.tile-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-chip {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfccb;
  color: #3f6212;
  font-size: 21rpx;
  font-weight: 700;
}

.scene-type {
  background: #d1fae5;
  color: #047857;
}

.tile-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.tile-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #64748b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tile-tag-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 21rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.half-button {
  flex: 1;
  padding: 0;
}
