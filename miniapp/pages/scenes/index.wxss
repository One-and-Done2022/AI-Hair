.scene-screen {
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-step-text {
  font-size: 20rpx;
  color: #5d6670;
}

.progress-percent {
  font-size: 28rpx;
  color: #0b5ecf;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #dadddf;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0058ba 0%, #5091ff 100%);
}

.progress-fill-complete {
  width: 100%;
}

.editorial-head {
  padding: 32rpx 4rpx 20rpx;
}

.insight-card {
  margin-top: 4rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(242, 247, 255, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(0, 88, 186, 0.08);
  box-shadow: 0 12rpx 30rpx rgba(0, 88, 186, 0.05);
}

.insight-kicker {
  font-size: 20rpx;
  font-weight: 700;
  color: #0b5ecf;
}

.insight-title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #20242a;
}

.insight-summary {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.48;
  color: #4d5762;
}

.insight-tag-row {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.insight-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.08);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 560rpx;
}

.combo-card {
  padding: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.combo-cover {
  width: 124rpx;
  height: 154rpx;
  border-radius: 24rpx;
  background: #eff1f2;
  flex-shrink: 0;
}

.combo-cover-stage {
  position: relative;
  width: 124rpx;
  height: 154rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #ffffff;
}

.combo-cover-hair {
  position: relative;
  z-index: 1;
  background: transparent;
}

.combo-body {
  flex: 1;
  min-width: 0;
}

.combo-label {
  font-size: 21rpx;
  color: #5d6670;
}

.combo-title {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.combo-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4d5762;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.combo-current {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5d6670;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.combo-link {
  color: #0b5ecf;
  font-size: 24rpx;
  font-weight: 700;
}

.style-switch {
  margin-top: 24rpx;
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  color: #4d5762;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 88, 186, 0.04);
}

.style-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.scene-list {
  margin-top: 26rpx;
  display: grid;
  gap: 22rpx;
}

.scene-card {
  padding: 20rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.scene-card.selected {
  box-shadow: 0 0 0 4rpx #0b5ecf, 0 18rpx 44rpx rgba(0, 88, 186, 0.08);
}

.scene-cover-shell {
  position: relative;
  border-radius: 26rpx;
  overflow: hidden;
}

.preview-pill {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
}

.scene-cover {
  width: 100%;
  height: 548rpx;
  border-radius: 26rpx;
  display: block;
  background: #eff1f2;
}

.scene-badge,
.scene-check {
  position: absolute;
  top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.scene-badge {
  left: 16rpx;
  background: rgba(0, 88, 186, 0.86);
}

.scene-check {
  right: 16rpx;
  background: rgba(0, 88, 186, 0.86);
}

.scene-body {
  margin-top: 18rpx;
}

.scene-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scene-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: #4d5762;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
}

.scene-chip-row {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.scene-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eff1f7;
  color: #4d5762;
  font-size: 20rpx;
  font-weight: 700;
}

.scene-chip-highlight {
  background: rgba(0, 88, 186, 0.1);
  color: #0b5ecf;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 18;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(249, 251, 255, 0) 0%, rgba(249, 251, 255, 0.96) 28%, #f9fbff 100%);
}

.generator-panel,
.advanced-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.generator-switch {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.generator-pill {
  min-width: 132rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #edf3ff;
  color: #5d6670;
  font-size: 24rpx;
  font-weight: 700;
}

.generator-pill.active {
  background: #0058ba;
  color: #ffffff;
}

.generator-pill.disabled {
  opacity: 0.42;
}

.generator-copy {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.advanced-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.advanced-toggle {
  color: #0b5ecf;
  font-size: 24rpx;
  font-weight: 700;
}

.advanced-body {
  margin-top: 22rpx;
}

.option-group + .option-group {
  margin-top: 22rpx;
}

.option-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #485260;
}

.option-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-chip {
  min-width: 108rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 88, 186, 0.12);
  background: rgba(255, 255, 255, 0.95);
  color: #4d5762;
  font-size: 24rpx;
  font-weight: 600;
}

.option-chip.active {
  border-color: rgba(0, 88, 186, 0.34);
  background: rgba(0, 88, 186, 0.1);
  color: #0058ba;
}

.bottom-helper {
  margin-top: 10rpx;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.42;
  color: #5d6670;
}
