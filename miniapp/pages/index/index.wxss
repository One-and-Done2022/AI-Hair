.landing-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.landing-head {
  padding: 10rpx 6rpx 28rpx;
}

.hero-title {
  margin-top: 14rpx;
  max-width: 620rpx;
}

.hero-subtitle {
  max-width: 560rpx;
}

.assist-row {
  margin-top: 22rpx;
}

.assist-button {
  display: inline-flex;
  min-width: 228rpx;
  padding: 0 30rpx;
}

.upload-panel {
  padding: 24rpx;
}

.upload-stage {
  margin-top: 8rpx;
}

.upload-stage-frame {
  min-height: 560rpx;
  border-radius: 30rpx;
  border: 2rpx dashed rgba(0, 88, 186, 0.28);
  background: #f6f9ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.upload-stage-deco {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 90rpx;
  height: 90rpx;
  border-radius: 28rpx;
  background: rgba(108, 159, 255, 0.16);
}

.upload-stage-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0058ba;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  animation: uploadPulse 1.8s ease-in-out infinite;
}

.upload-stage-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #20242a;
}

.upload-stage-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #4d5762;
}

.preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  background: #e6ebf3;
}

.preview-image {
  width: 100%;
  height: 680rpx;
  display: block;
}

.preview-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.86);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}

.preview-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.compact-button {
  flex: 1;
  height: 78rpx;
  line-height: 1.1;
  font-size: 28rpx;
  padding: 0 22rpx;
}

.upload-status {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
}

.upload-status.ready {
  background: rgba(14, 165, 132, 0.08);
}

.upload-status.working {
  background: rgba(0, 88, 186, 0.08);
}

.upload-status.idle {
  background: rgba(91, 103, 117, 0.08);
}

.upload-status-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #3d4752;
}

.upload-status.ready .upload-status-text {
  color: #0f766e;
}

.upload-status.working .upload-status-text {
  color: #0b5ecf;
}

.upload-progress {
  margin-top: 12rpx;
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(0, 88, 186, 0.12);
}

.upload-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #60a5fa 0%, #2563eb 100%);
  transition: width 0.2s ease;
}

.upload-progress-fill.preparing {
  width: 36%;
  animation: uploadPreparing 1.2s ease-in-out infinite alternate;
}

.recommendation-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.recommendation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.recommendation-title {
  flex: 1;
  min-width: 0;
}

.recommendation-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(11, 94, 207, 0.12);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
}

.recommendation-copy {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.recommendation-button {
  margin-top: 18rpx;
  width: 100%;
}

.floating-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(0, 88, 186, 0.1);
}

.floating-helper {
  margin-top: 10rpx;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.42;
  color: #5d6670;
}

@keyframes uploadPreparing {
  from {
    width: 24%;
    opacity: 0.72;
  }

  to {
    width: 52%;
    opacity: 1;
  }
}

@keyframes uploadPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  }

  50% {
    transform: scale(1.05);
    box-shadow: 0 18rpx 40rpx rgba(0, 88, 186, 0.16);
  }
}
