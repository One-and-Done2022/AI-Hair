.landing-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.landing-head {
  padding: 10rpx 6rpx 24rpx;
}

.hero-title {
  margin-top: 14rpx;
  max-width: 620rpx;
}

.hero-subtitle {
  max-width: 590rpx;
}

.quota-pill {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(0, 88, 186, 0.08);
}

.showcase-section {
  margin-top: 8rpx;
}

.provider-alert {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #fff8eb;
  border: 1rpx solid rgba(245, 158, 11, 0.22);
}

.provider-alert-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #9a6700;
}

.provider-alert-message {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7a4a00;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.section-row-tight {
  align-items: flex-start;
}

.section-note {
  font-size: 22rpx;
  color: #5d6670;
}

.showcase-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.showcase-card {
  overflow: hidden;
}

.showcase-cover {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #e2e8f0;
}

.showcase-body {
  padding: 18rpx;
}

.showcase-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.showcase-summary {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.42;
  color: #4d5762;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.upload-panel,
.analysis-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.upload-stage {
  margin-top: 18rpx;
}

.upload-stage-frame {
  min-height: 540rpx;
  border-radius: 30rpx;
  border: 2rpx dashed rgba(0, 88, 186, 0.24);
  background: #f6f9ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-stage-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0058ba;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  animation: uploadPulse 1.8s ease-in-out infinite;
}

.upload-stage-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #20242a;
}

.upload-stage-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4d5762;
}

.preview-shell {
  margin-top: 18rpx;
}

.preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  background: #e6ebf3;
}

.preview-image {
  width: 100%;
  height: 680rpx;
  display: block;
}

.preview-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.86);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}

.preview-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.compact-button {
  flex: 1;
  height: 78rpx;
  line-height: 1.1;
  font-size: 28rpx;
  padding: 0 22rpx;
}

.upload-status {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
}

.upload-status.ready {
  background: rgba(14, 165, 132, 0.08);
}

.upload-status.working {
  background: rgba(0, 88, 186, 0.08);
}

.upload-status.idle {
  background: rgba(91, 103, 117, 0.08);
}

.upload-status.invalid {
  background: rgba(220, 38, 38, 0.08);
}

.upload-status-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #3d4752;
}

.upload-status.ready .upload-status-text {
  color: #0f766e;
}

.upload-status.working .upload-status-text {
  color: #0b5ecf;
}

.upload-status.invalid .upload-status-text {
  color: #b91c1c;
}

.upload-progress {
  margin-top: 12rpx;
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(0, 88, 186, 0.12);
}

.upload-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #60a5fa 0%, #2563eb 100%);
  transition: width 0.2s ease;
}

.upload-progress-fill.preparing {
  width: 36%;
  animation: uploadPreparing 1.2s ease-in-out infinite alternate;
}

.current-selection {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(0, 88, 186, 0.06);
}

.current-selection-line {
  font-size: 22rpx;
  line-height: 1.48;
  color: #5d6670;
}

.current-selection-line + .current-selection-line {
  margin-top: 6rpx;
}

.analysis-summary {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.analysis-pill {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.1);
  color: #0b5ecf;
  font-size: 21rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
}

.analysis-shape {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
}

.analysis-group {
  margin-top: 18rpx;
}

.analysis-group-label {
  font-size: 22rpx;
  color: #5d6670;
}

.analysis-chip-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.analysis-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.12);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
}

.analysis-chip.light {
  background: #eff1f7;
  color: #4d5762;
}

.analysis-button {
  margin-top: 22rpx;
  width: 100%;
}

@keyframes uploadPulse {
  0% {
    transform: scale(1);
  }

  100% {
    transform: scale(1.06);
  }
}

@keyframes uploadPreparing {
  0% {
    width: 28%;
  }

  100% {
    width: 48%;
  }
}
