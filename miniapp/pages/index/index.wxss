.landing-screen {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.landing-hero {
  padding: 34rpx;
  background:
    radial-gradient(circle at top right, rgba(125, 211, 252, 0.4), transparent 38%),
    linear-gradient(135deg, #0f172a 0%, #1d4ed8 52%, #0f766e 100%);
  color: #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.landing-hero .subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.hero-cta {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.hero-points {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.hero-point {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 23rpx;
}

.section-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.step-kicker {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.section-hint {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.upload-dropzone {
  min-height: 400rpx;
  border: 2rpx dashed #93c5fd;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(239, 246, 255, 0.96), rgba(248, 250, 252, 0.98)),
    #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 34rpx;
}

.dropzone-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #dbeafe, #e0f2fe);
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  margin-bottom: 18rpx;
}

.dropzone-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.dropzone-copy {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #475569;
}

.dropzone-cta {
  margin-top: 22rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.upload-preview-shell {
  display: grid;
  gap: 18rpx;
}

.upload-preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: #dbe4f0;
}

.preview-image {
  width: 100%;
  height: 760rpx;
  display: block;
}

.preview-overlay {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.preview-badge,
.preview-caption {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.62);
  color: #ffffff;
  font-size: 22rpx;
  backdrop-filter: blur(10rpx);
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.mini-button {
  flex: 1;
  min-width: 200rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 26rpx;
}

.quality-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eff6ff, #f8fafc);
}

.quality-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.quality-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.photo-guide-grid {
  margin-top: 22rpx;
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.guide-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.guide-good {
  background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
}

.guide-bad {
  background: linear-gradient(135deg, #fff7ed, #fff1f2);
}

.guide-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.guide-line {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #475569;
}

.selection-stack {
  display: grid;
  gap: 18rpx;
}

.selection-summary-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  border: 2rpx solid #e2e8f0;
}

.selection-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 22rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.selection-body {
  flex: 1;
  min-width: 0;
}

.selection-label {
  color: #64748b;
  font-size: 23rpx;
}

.selection-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.selection-meta {
  margin-top: 8rpx;
  color: #2563eb;
  font-size: 24rpx;
  line-height: 1.5;
}

.selection-arrow {
  color: #94a3b8;
  font-size: 36rpx;
  font-weight: 700;
}

.selection-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.half-button {
  flex: 1;
  padding: 0;
}

.trust-card {
  margin-top: 24rpx;
}

.trust-list {
  display: grid;
  gap: 16rpx;
}

.trust-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f8fafc, #ffffff);
  color: #334155;
  font-size: 24rpx;
  line-height: 1.7;
}

.history-button {
  margin-top: 20rpx;
}

.generate-button {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
}

.generate-button[disabled] {
  background: linear-gradient(135deg, #cbd5e1, #94a3b8);
  color: rgba(255, 255, 255, 0.92);
}
