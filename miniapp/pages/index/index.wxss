.landing-screen {
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}

.landing-copy {
  padding: 18rpx 8rpx 30rpx;
}

.landing-topline {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.soft-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  color: #6f5a52;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 20rpx;
  max-width: 620rpx;
}

.hero-subtitle {
  max-width: 620rpx;
}

.upload-panel,
.selection-panel {
  padding: 28rpx;
}

.selection-panel {
  margin-top: 24rpx;
}

.upload-stage {
  margin-top: 22rpx;
  min-height: 560rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at top, rgba(239, 214, 203, 0.72), transparent 34%),
    linear-gradient(180deg, #fffaf8 0%, #f8eeea 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.upload-stage-icon {
  width: 124rpx;
  height: 124rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #a06d62;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 66rpx;
  box-shadow: 0 16rpx 36rpx rgba(157, 111, 99, 0.12);
}

.upload-stage-title {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #302520;
}

.upload-stage-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8d786d;
}

.photo-preview-block {
  margin-top: 22rpx;
}

.photo-preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: #e8ddd7;
}

.photo-preview-image {
  width: 100%;
  height: 760rpx;
  display: block;
}

.photo-preview-overlay {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-preview-pill,
.photo-preview-caption {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(48, 37, 32, 0.56);
  color: #ffffff;
  font-size: 22rpx;
}

.photo-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.compact-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
}

.guide-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.guide-pill {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f7ece6;
  color: #8f6e64;
  font-size: 22rpx;
}

.selection-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.selection-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #302520;
}

.selection-state {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f7ece6;
  color: #9d6f63;
  font-size: 22rpx;
  font-weight: 700;
}

.selection-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.selection-card {
  padding: 18rpx;
  border-radius: 28rpx;
  background: #fbf6f2;
}

.selection-card.filled {
  background: linear-gradient(180deg, #fffaf7 0%, #f6ece6 100%);
  box-shadow: 0 14rpx 32rpx rgba(157, 111, 99, 0.08);
}

.selection-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 22rpx;
  background: #eadfd9;
  display: block;
}

.selection-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b79a90;
  font-size: 48rpx;
  font-weight: 700;
}

.scene-placeholder {
  background: #efe6e0;
}

.selection-label {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a08679;
}

.selection-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #302520;
  line-height: 1.4;
}

.selection-helper {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8d786d;
}

.generate-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  padding: 18rpx;
  border-radius: 36rpx;
  background: rgba(255, 248, 244, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(86, 66, 57, 0.1);
}

.generate-button {
  width: 100%;
}

.generate-helper {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9b8578;
}

@media (max-width: 360px) {
  .selection-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .photo-actions {
    flex-direction: column;
  }
}
