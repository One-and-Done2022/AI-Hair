.hero {
  padding: 34rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #38bdf8 100%);
  color: #ffffff;
}

.hero .subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.hero-chips {
  margin-top: 28rpx;
}

.hero-chips .chip {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.section {
  margin-top: 24rpx;
  padding: 30rpx;
}

.preview-box {
  overflow: hidden;
  border-radius: 24rpx;
  background: #e2e8f0;
}

.preview-image {
  width: 100%;
  height: 720rpx;
  display: block;
}

.preview-tip {
  padding: 18rpx 24rpx;
  color: #475569;
  font-size: 24rpx;
}

.upload-placeholder {
  min-height: 360rpx;
  border: 2rpx dashed #bfdbfe;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #edf5ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30rpx;
}

.upload-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.upload-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.action-button {
  margin-top: 24rpx;
}

.selection-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 22rpx;
  margin-bottom: 18rpx;
}

.selection-label {
  color: #64748b;
  font-size: 24rpx;
}

.selection-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.selection-arrow {
  color: #94a3b8;
  font-size: 34rpx;
}

.generate-button {
  margin-top: 28rpx;
  margin-bottom: 40rpx;
}

