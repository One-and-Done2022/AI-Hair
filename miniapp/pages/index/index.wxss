.landing-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.landing-head {
  padding: 10rpx 6rpx 28rpx;
}

.hero-title {
  margin-top: 14rpx;
  max-width: 600rpx;
}

.hero-subtitle {
  max-width: 540rpx;
}

.showcase-section {
  margin-bottom: 24rpx;
}

.showcase-head {
  padding: 0 6rpx 12rpx;
}

.showcase-title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2c2f30;
}

.showcase-scroll {
  white-space: nowrap;
}

.showcase-card {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  width: 228rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 36rpx rgba(0, 88, 186, 0.08);
}

.showcase-image {
  width: 100%;
  height: 304rpx;
  background: #e2e8f0;
}

.showcase-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.82);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.showcase-name {
  padding: 18rpx 18rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #2c2f30;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-panel,
.selection-panel {
  padding: 24rpx;
}

.selection-panel {
  margin-top: 24rpx;
}

.upload-stage {
  margin-top: 8rpx;
}

.upload-stage-frame {
  min-height: 560rpx;
  border-radius: 30rpx;
  border: 2rpx dashed rgba(0, 88, 186, 0.22);
  background: #f3f6fb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.upload-stage-deco {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 90rpx;
  height: 90rpx;
  border-radius: 28rpx;
  background: rgba(108, 159, 255, 0.16);
}

.upload-stage-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0058ba;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  animation: uploadPulse 1.8s ease-in-out infinite;
}

.upload-stage-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2c2f30;
}

.upload-stage-copy {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #595c5d;
}

.preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  background: #e6ebf3;
}

.preview-image {
  width: 100%;
  height: 680rpx;
  display: block;
}

.preview-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.86);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.preview-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.compact-button {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 26rpx;
}

.guide-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.privacy-note {
  margin-top: 18rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #757778;
}

.guide-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.guide-thumb {
  width: 100%;
  height: 150rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #eef1f5 0%, #dadee4 100%);
  position: relative;
  overflow: hidden;
}

.guide-figure {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 104rpx;
  height: 112rpx;
  transform: translate(-50%, -50%);
}

.guide-figure-front,
.guide-figure-side {
  position: absolute;
}

.guide-head {
  position: absolute;
  left: 50%;
  top: 12rpx;
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: rgba(89, 92, 93, 0.18);
  transform: translateX(-50%);
}

.guide-body {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 96rpx;
  height: 56rpx;
  border-radius: 50rpx 50rpx 30rpx 30rpx;
  background: rgba(89, 92, 93, 0.14);
  transform: translateX(-50%);
}

.guide-figure-side {
  transform: translate(-44%, -50%);
}

.guide-figure-side .guide-body {
  width: 84rpx;
}

.guide-thumb-bad {
  background: linear-gradient(180deg, #fff0f0 0%, #fde5e5 100%);
}

.guide-ban-ring,
.guide-ban-line {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.guide-ban-ring {
  width: 86rpx;
  height: 86rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 6rpx solid rgba(179, 27, 37, 0.72);
}

.guide-ban-line {
  width: 68rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(179, 27, 37, 0.72);
  transform: translate(-50%, -50%) rotate(-45deg);
}

.guide-label {
  font-size: 20rpx;
  color: #757778;
  font-weight: 600;
}

.guide-label-bad {
  color: #b31b25;
}

.selection-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.selection-title {
  margin-top: 12rpx;
}

.selection-link {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #0058ba;
  font-size: 22rpx;
  font-weight: 700;
}

.selection-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.selection-card {
  padding: 16rpx;
  border-radius: 28rpx;
  background: #f6f8fb;
}

.selection-card.filled {
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.08);
}

.selection-cover {
  width: 100%;
  height: 210rpx;
  border-radius: 22rpx;
  background: #e2e8f0;
  display: block;
}

.selection-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #757778;
  font-size: 28rpx;
  font-weight: 700;
}

.selection-label {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #757778;
}

.selection-value {
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #2c2f30;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.floating-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 18rpx 48rpx rgba(0, 88, 186, 0.12);
}

.floating-helper {
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #757778;
}

@keyframes uploadPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  }

  50% {
    transform: scale(1.05);
    box-shadow: 0 18rpx 40rpx rgba(0, 88, 186, 0.16);
  }
}
