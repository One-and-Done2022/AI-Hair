.landing-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.landing-head {
  padding: 10rpx 6rpx 28rpx;
}

.hero-title {
  margin-top: 14rpx;
  max-width: 620rpx;
}

.hero-subtitle {
  max-width: 560rpx;
}

.quota-pill {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(0, 88, 186, 0.08);
}

.showcase-section {
  margin-bottom: 24rpx;
}

.showcase-head {
  padding: 0 6rpx 12rpx;
}

.showcase-title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #20242a;
}

.showcase-scroll {
  white-space: nowrap;
}

.showcase-card {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  width: 228rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.06);
}

.showcase-image {
  width: 100%;
  height: 304rpx;
  background: #e2e8f0;
}

.showcase-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.82);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.showcase-name {
  padding: 18rpx 18rpx 20rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-panel,
.selection-panel {
  padding: 24rpx;
}

.selection-panel {
  margin-top: 24rpx;
}

.output-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.upload-stage {
  margin-top: 8rpx;
}

.upload-stage-frame {
  min-height: 560rpx;
  border-radius: 30rpx;
  border: 2rpx dashed rgba(0, 88, 186, 0.28);
  background: #f6f9ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.upload-stage-deco {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 90rpx;
  height: 90rpx;
  border-radius: 28rpx;
  background: rgba(108, 159, 255, 0.16);
}

.upload-stage-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0058ba;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  animation: uploadPulse 1.8s ease-in-out infinite;
}

.upload-stage-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #20242a;
}

.upload-stage-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #4d5762;
}

.preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  background: #e6ebf3;
}

.preview-image {
  width: 100%;
  height: 680rpx;
  display: block;
}

.preview-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.86);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
}

.preview-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.upload-status {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
}

.upload-status.ready {
  background: rgba(14, 165, 132, 0.08);
}

.upload-status.working {
  background: rgba(0, 88, 186, 0.08);
}

.upload-status.idle {
  background: rgba(91, 103, 117, 0.08);
}

.upload-status-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #3d4752;
}

.upload-status.ready .upload-status-text {
  color: #0f766e;
}

.upload-status.working .upload-status-text {
  color: #0b5ecf;
}

.upload-progress {
  margin-top: 12rpx;
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(0, 88, 186, 0.12);
}

.upload-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #60a5fa 0%, #2563eb 100%);
  transition: width 0.2s ease;
}

.upload-progress-fill.preparing {
  width: 36%;
  animation: uploadPreparing 1.2s ease-in-out infinite alternate;
}

.compact-button {
  flex: 1;
  height: 78rpx;
  line-height: 1.1;
  font-size: 28rpx;
  padding: 0 22rpx;
}

.guide-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.privacy-note {
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.42;
  color: #5d6670;
}

.option-group + .option-group {
  margin-top: 22rpx;
}

.generator-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.generator-card {
  min-height: 128rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 88, 186, 0.1);
  background: rgba(255, 255, 255, 0.96);
}

.generator-card.active {
  border-color: rgba(0, 88, 186, 0.3);
  background: rgba(0, 88, 186, 0.08);
  box-shadow: 0 12rpx 26rpx rgba(0, 88, 186, 0.08);
}

.generator-card.disabled {
  opacity: 0.42;
}

.generator-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #20242a;
}

.generator-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #5a6470;
}

.option-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #485260;
}

@keyframes uploadPreparing {
  from {
    width: 24%;
    opacity: 0.72;
  }
  to {
    width: 52%;
    opacity: 1;
  }
}

.option-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-chip {
  min-width: 108rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 88, 186, 0.12);
  background: rgba(255, 255, 255, 0.95);
  color: #4d5762;
  font-size: 24rpx;
  font-weight: 600;
}

.option-chip.active {
  border-color: rgba(0, 88, 186, 0.34);
  background: rgba(0, 88, 186, 0.1);
  color: #0058ba;
}

.guide-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.guide-thumb {
  width: 100%;
  height: 172rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #eef1f5 0%, #dadee4 100%);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(0, 88, 186, 0.08);
}

.guide-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.guide-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(14, 165, 132, 0.9);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.guide-badge-soft {
  background: rgba(11, 94, 207, 0.88);
}

.guide-thumb-bad {
  background: linear-gradient(180deg, #fff0f0 0%, #fde5e5 100%);
}

.guide-badge-bad {
  background: rgba(179, 27, 37, 0.9);
}

.guide-label {
  font-size: 22rpx;
  color: #5d6670;
  font-weight: 600;
}

.guide-label-bad {
  color: #b31b25;
}

.selection-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.selection-title {
  margin-top: 12rpx;
}

.selection-link {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 24rpx;
  font-weight: 700;
}

.selection-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.recommend-shell {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(246, 249, 255, 0.96) 0%, rgba(255, 255, 255, 0.96) 100%);
  border: 1rpx solid rgba(0, 88, 186, 0.06);
}

.recommend-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
}

.recommend-gender-switch {
  display: inline-flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #edf3ff;
}

.recommend-gender-pill {
  min-width: 96rpx;
  padding: 12rpx 18rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5d6670;
}

.recommend-gender-pill.active {
  background: #0058ba;
  color: #ffffff;
}

.recommend-trigger {
  margin-top: 18rpx;
  width: 100%;
  height: 82rpx;
  font-size: 28rpx;
}

.recommend-status {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #5d6670;
}

.recommend-result {
  margin-top: 20rpx;
}

.recommend-group + .recommend-group {
  margin-top: 20rpx;
}

.recommend-group-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
}

.recommend-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.recommend-card {
  display: inline-flex;
  flex-direction: column;
  width: 220rpx;
  margin-right: 16rpx;
  padding: 10rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 12rpx 28rpx rgba(0, 88, 186, 0.05);
}

.recommend-card.selected {
  box-shadow: 0 0 0 3rpx rgba(0, 88, 186, 0.2), 0 14rpx 30rpx rgba(0, 88, 186, 0.08);
}

.recommend-cover {
  width: 100%;
  height: 248rpx;
  border-radius: 18rpx;
  background: #e2e8f0;
  display: block;
}

.recommend-cover-stage {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f4f6f9 0%, #edf1f5 100%);
}

.recommend-cover-backdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.65;
  transform: scale(1.08);
  filter: blur(10rpx);
}

.recommend-cover-backdrop-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(244, 247, 251, 0.46) 100%);
}

.recommend-cover-hair {
  position: relative;
  z-index: 1;
  height: 286rpx;
  background: transparent;
}

.recommend-cover-scene {
  height: 300rpx;
}

.recommend-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend-reason {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.42;
  color: #5d6670;
  white-space: normal;
}

.recommend-action {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b5ecf;
}

.selection-card {
  padding: 16rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
}

.selection-card.filled {
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.06);
}

.selection-cover {
  width: 100%;
  height: 210rpx;
  border-radius: 22rpx;
  background: #e2e8f0;
  display: block;
}

.selection-cover-stage {
  position: relative;
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f4f6f9 0%, #edf1f5 100%);
}

.selection-cover-backdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.65;
  transform: scale(1.08);
  filter: blur(10rpx);
}

.selection-cover-backdrop-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(244, 247, 251, 0.46) 100%);
}

.selection-cover-hair {
  position: relative;
  z-index: 1;
  height: 248rpx;
  background: transparent;
}

.selection-cover-scene {
  height: 280rpx;
}

.selection-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d6670;
  font-size: 28rpx;
  font-weight: 700;
}

.selection-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.selection-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.floating-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(0, 88, 186, 0.1);
}

.floating-helper {
  margin-top: 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: #5d6670;
}

@keyframes uploadPulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.1);
  }

  50% {
    transform: scale(1.05);
    box-shadow: 0 18rpx 40rpx rgba(0, 88, 186, 0.16);
  }
}
