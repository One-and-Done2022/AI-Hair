<view class="screen landing-screen">
  <view class="landing-head">
    <view class="title hero-title">上传照片，开始换发</view>
    <view class="subtitle hero-subtitle">先上传清晰自拍照，再按步骤选择发型、场景和参数。</view>
    <view wx:if="{{profileSummary}}" class="quota-pill">剩余 {{profileSummary.total_remaining || profileSummary.remaining_quota}} 次</view>
  </view>


  <view wx:if="{{showcases.length}}" class="showcase-section">
    <view class="section-row">
      <view class="section-title">精选示例</view>
    </view>
    <view class="showcase-grid">
      <view
        wx:for="{{showcases}}"
        wx:key="id"
        class="showcase-card panel {{item.is_active ? 'active' : ''}}"
        bindtap="applyShowcaseTemplate"
        data-id="{{item.id}}"
      >
        <view class="showcase-badge">精选示例</view>
        <view wx:if="{{item.is_active}}" class="showcase-state-pill">当前已套用</view>
        <image class="showcase-cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load="true"></image>
        <view class="showcase-body">
          <view class="showcase-name">{{item.title}}</view>
          <view class="showcase-scene">{{item.scene_name}}</view>
          <view class="showcase-tag-row">
            <view wx:if="{{item.hair_color_mode_label}}" class="showcase-tag showcase-tag-accent">{{item.hair_color_mode_label}}</view>
            <view wx:if="{{item.hair_color_primary_label}}" class="showcase-tag">{{item.hair_color_primary_label}}</view>
          </view>
          <view wx:if="{{item.summary}}" class="showcase-summary">{{item.summary}}</view>
          <view class="showcase-action {{item.is_active ? 'active' : ''}}">
            {{item.action_label}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="panel upload-panel">
    <view class="section-row section-row-tight">
      <view class="section-title">上传照片</view>
      <view class="section-note">支持 JPG、PNG</view>
    </view>

    <view wx:if="{{selectedImage}}" class="preview-shell">
      <view class="preview-card" bindtap="previewImage">
        <image class="preview-image" src="{{selectedImage}}" mode="aspectFill"></image>
        <view class="preview-badge">
          {{imagePreparing ? '处理中' : (uploadReady ? '已通过' : (uploadPriming ? '上传中' : (uploadInvalid ? '需重选' : '已选择')))}}
        </view>
      </view>
      <view class="preview-actions">
        <button class="secondary-button compact-button" bindtap="chooseImage">重选相册</button>
        <button class="secondary-button compact-button" bindtap="takeSelfie">重新自拍</button>
      </view>
    </view>

    <view wx:else class="upload-stage" bindtap="openImageSource">
      <view class="upload-stage-frame">
        <view class="upload-stage-icon">+</view>
        <view class="upload-stage-title">点击上传照片</view>
        <view class="upload-stage-copy">建议清晰单人正脸或半侧脸自拍</view>
      </view>
    </view>

    <view
      wx:if="{{selectedImage && uploadMessage}}"
      class="upload-status {{uploadInvalid ? 'invalid' : (uploadReady ? 'ready' : ((imagePreparing || uploadPriming) ? 'working' : 'idle'))}}"
    >
      <view class="upload-status-text">{{uploadMessage}}</view>
      <view wx:if="{{imagePreparing || uploadPriming}}" class="upload-progress">
        <view
          class="upload-progress-fill {{imagePreparing ? 'preparing' : ''}}"
          style="width: {{imagePreparing ? 36 : uploadProgress}}%;"
        ></view>
      </view>
    </view>

    <view wx:if="{{selectedHairstyleName || selectedSceneName}}" class="current-selection">
      <view class="current-selection-line">已选发型：{{selectedHairstyleName || '未选择'}}</view>
      <view class="current-selection-line">已选场景：{{selectedSceneName || '未选择'}}</view>
    </view>
  </view>

  <view class="panel analysis-panel">
    <view class="section-row section-row-tight">
      <view class="section-title">{{recommendationTitle}}</view>
      <view wx:if="{{recommendationState === 'ready'}}" class="analysis-pill">已完成</view>
    </view>
    <view class="analysis-summary">{{recommendationSummary}}</view>

    <view wx:if="{{recommendationFaceShape}}" class="analysis-shape">脸型：{{recommendationFaceShape}}</view>

    <view wx:if="{{recommendationFeatureTags.length}}" class="analysis-chip-row">
      <view wx:for="{{recommendationFeatureTags}}" wx:key="*this" class="analysis-chip">{{item}}</view>
    </view>

    <view wx:if="{{recommendationHairstyles.length}}" class="analysis-group">
      <view class="analysis-group-label">推荐发型</view>
      <view class="analysis-chip-row">
        <view wx:for="{{recommendationHairstyles}}" wx:key="*this" class="analysis-chip light">{{item}}</view>
      </view>
    </view>

    <view wx:if="{{recommendationScenes.length}}" class="analysis-group">
      <view class="analysis-group-label">推荐场景</view>
      <view class="analysis-chip-row">
        <view wx:for="{{recommendationScenes}}" wx:key="*this" class="analysis-chip light">{{item}}</view>
      </view>
    </view>

    <button
      wx:if="{{selectedImage}}"
      class="secondary-button analysis-button"
      bindtap="openRecommendation"
    >
      查看推荐
    </button>
  </view>

  <view class="floating-bar">
    <button class="primary-button" bindtap="goNext" disabled="{{!selectedImage || imagePreparing || uploadInvalid}}">
      选发型
    </button>
  </view>
</view>
