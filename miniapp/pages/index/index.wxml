<view class="screen landing-screen">
  <view class="landing-copy">
    <view class="landing-topline">
      <view class="section-kicker">AIFace Studio</view>
      <view class="soft-tag">自然换发</view>
    </view>
    <view class="title hero-title">一张生活照，换一组更自然的发型写真</view>
    <view class="subtitle hero-subtitle">上传照片，选择发型与场景，系统会尽量保留你的真实身份感。</view>
  </view>

  <view class="panel upload-panel">
    <view class="section-kicker">上传照片</view>

    <view wx:if="{{selectedImage}}" class="photo-preview-block">
      <view class="photo-preview-card" bindtap="previewImage">
        <image class="photo-preview-image" src="{{selectedImage}}" mode="aspectFill"></image>
        <view class="photo-preview-overlay">
          <view class="photo-preview-pill">已上传</view>
          <view class="photo-preview-caption">点击查看原图</view>
        </view>
      </view>

      <view class="photo-actions">
        <button class="secondary-button compact-button" bindtap="chooseImage">重选相册</button>
        <button class="secondary-button compact-button" bindtap="takeSelfie">重新自拍</button>
      </view>
    </view>

    <view wx:else class="upload-stage" bindtap="openImageSource">
      <view class="upload-stage-icon">+</view>
      <view class="upload-stage-title">点击上传单人照片</view>
      <view class="upload-stage-copy">支持相册和自拍</view>
    </view>

    <view class="guide-row">
      <view class="guide-pill">单人近景</view>
      <view class="guide-pill">自然光</view>
      <view class="guide-pill">无遮挡</view>
      <view class="guide-pill">JPG / PNG</view>
    </view>
  </view>

  <view class="panel selection-panel">
    <view class="selection-head">
      <view>
        <view class="section-kicker">风格搭配</view>
        <view class="selection-title">先选发型，再选场景</view>
      </view>
      <view class="selection-state">{{selectedHairstyle && selectedScene ? '已完成' : '待选择'}}</view>
    </view>

    <view class="selection-grid">
      <view class="selection-card {{selectedHairstyle ? 'filled' : ''}}" bindtap="openTemplatePicker">
        <image
          wx:if="{{selectedHairstyle && selectedHairstyle.cover_url}}"
          class="selection-cover"
          src="{{selectedHairstyle.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:else class="selection-cover selection-placeholder">发</view>
        <view class="selection-label">发型</view>
        <view class="selection-value">{{selectedHairstyle ? selectedHairstyle.name : '去选择发型'}}</view>
      </view>

      <view class="selection-card {{selectedScene ? 'filled' : ''}}" bindtap="openScenePicker">
        <image
          wx:if="{{selectedScene && selectedScene.cover_url}}"
          class="selection-cover"
          src="{{selectedScene.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:else class="selection-cover selection-placeholder scene-placeholder">景</view>
        <view class="selection-label">场景</view>
        <view class="selection-value">{{selectedScene ? selectedScene.name : '去选择场景'}}</view>
      </view>
    </view>

    <view class="selection-helper">
      {{selectedHairstyle && selectedScene ? '搭配已准备好，可以直接开始生成。' : '发型决定整体风格，场景在下一页完成选择。'}}
    </view>
  </view>

  <view class="generate-bar">
    <button
      class="primary-button generate-button"
      loading="{{loading}}"
      disabled="{{!selectedImage || !selectedHairstyle || !selectedScene || loading}}"
      bindtap="createJob"
    >
      {{selectedImage && selectedHairstyle && selectedScene ? '开始生成' : '请先完成上传与搭配'}}
    </button>
    <view class="generate-helper">结果会自动保存在历史记录</view>
  </view>
</view>
