<view class="screen">
  <view class="hero-card hero">
    <view class="title">上传一张生活照，生成全新发型写真</view>
    <view class="subtitle">
      首版支持单人照片上传、预置发型和场景模板、异步生成与历史记录查看。
    </view>
    <view class="chip-row hero-chips">
      <view class="chip">单图生成</view>
      <view class="chip">保留人脸特征</view>
      <view class="chip">换发 + 换背景</view>
    </view>
  </view>

  <view class="panel section">
    <view class="section-title">1. 上传照片</view>
    <view wx:if="{{selectedImage}}" class="preview-box" bindtap="previewImage">
      <image class="preview-image" src="{{selectedImage}}" mode="aspectFill"></image>
      <view class="preview-tip">点击预览原图</view>
    </view>
    <view wx:else class="upload-placeholder" bindtap="chooseImage">
      <view class="upload-icon">+</view>
      <view class="upload-title">选择单人正脸或半侧脸生活照</view>
      <view class="subtitle">建议光线清晰、无遮挡、分辨率不少于 512px</view>
    </view>
    <button class="secondary-button action-button" bindtap="chooseImage">
      {{selectedImage ? '重新选择照片' : '上传照片'}}
    </button>
  </view>

  <view class="panel section">
    <view class="section-title">2. 发型与场景</view>
    <view class="selection-card" bindtap="openTemplatePicker">
      <view>
        <view class="selection-label">已选发型</view>
        <view class="selection-value">{{selectedHairstyle ? selectedHairstyle.name : '去选择'}}</view>
      </view>
      <view class="selection-arrow">></view>
    </view>
    <view class="selection-card" bindtap="openTemplatePicker">
      <view>
        <view class="selection-label">已选场景</view>
        <view class="selection-value">{{selectedScene ? selectedScene.name : '去选择'}}</view>
      </view>
      <view class="selection-arrow">></view>
    </view>
    <button class="secondary-button action-button" bindtap="openTemplatePicker">选择模板</button>
  </view>

  <button class="primary-button generate-button" loading="{{loading}}" bindtap="createJob">
    3. 开始生成
  </button>
</view>

