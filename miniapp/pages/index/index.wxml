<view class="screen landing-screen">
  <view class="landing-head">
    <view class="section-kicker">CREATE YOUR LOOK</view>
    <view class="title hero-title">上传照片，开始换发</view>
    <view class="subtitle hero-subtitle">支持相册和自拍，先选发型，再配场景。</view>
    <view wx:if="{{profileSummary}}" class="quota-pill">
      剩余次数 {{profileSummary.remaining_quota}} · 本月已用 {{profileSummary.monthly_used}}
    </view>
  </view>

  <view wx:if="{{showcaseItems.length}}" class="showcase-section">
    <view class="showcase-head">
      <view class="section-kicker">LOOK PREVIEW</view>
      <view class="showcase-title">效果示例</view>
    </view>
    <scroll-view class="showcase-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view
        wx:for="{{showcaseItems}}"
        wx:key="id"
        class="showcase-card"
      >
        <image class="showcase-image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="true"></image>
        <view class="showcase-tag">{{item.tag}}</view>
        <view class="showcase-name">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="panel upload-panel">
    <view wx:if="{{selectedImage}}" class="preview-shell">
      <view class="preview-card" bindtap="previewImage">
        <image class="preview-image" src="{{selectedImage}}" mode="aspectFill"></image>
        <view class="preview-badge">已上传</view>
      </view>
      <view class="preview-actions">
        <button class="secondary-button compact-button" bindtap="chooseImage">重选相册</button>
        <button class="secondary-button compact-button" bindtap="takeSelfie">重新自拍</button>
      </view>
    </view>

    <view wx:else class="upload-stage" bindtap="openImageSource">
      <view class="upload-stage-frame">
        <view class="upload-stage-deco"></view>
        <view class="upload-stage-icon">+</view>
        <view class="upload-stage-title">点击上传照片</view>
        <view class="upload-stage-copy">支持 JPG、PNG 格式</view>
      </view>
    </view>

    <view class="guide-grid">
      <view class="guide-card">
        <view class="guide-thumb">
          <view class="guide-figure guide-figure-front">
            <view class="guide-head"></view>
            <view class="guide-body"></view>
          </view>
        </view>
        <view class="guide-label">正面示例</view>
      </view>
      <view class="guide-card">
        <view class="guide-thumb">
          <view class="guide-figure guide-figure-side">
            <view class="guide-head"></view>
            <view class="guide-body"></view>
          </view>
        </view>
        <view class="guide-label">侧面示例</view>
      </view>
      <view class="guide-card guide-card-bad">
        <view class="guide-thumb guide-thumb-bad">
          <view class="guide-ban-ring"></view>
          <view class="guide-ban-line"></view>
        </view>
        <view class="guide-label guide-label-bad">不可遮挡</view>
      </view>
    </view>
    <view class="privacy-note">照片仅用于本次生成与历史记录展示，不会公开原图。</view>
  </view>

  <view class="panel selection-panel">
    <view class="selection-top">
      <view>
        <view class="section-kicker">STYLE SET</view>
        <view class="section-title selection-title">选择搭配</view>
      </view>
      <view class="selection-link" bindtap="goHistory">作品</view>
    </view>

    <view class="selection-grid">
      <view class="selection-card {{selectedHairstyle ? 'filled' : ''}}" bindtap="openTemplatePicker">
        <image
          wx:if="{{selectedHairstyle && selectedHairstyle.cover_url}}"
          class="selection-cover"
          src="{{selectedHairstyle.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:else class="selection-cover selection-placeholder">发型</view>
        <view class="selection-label">已选发型</view>
        <view class="selection-value">{{selectedHairstyle ? selectedHairstyle.name : '去选择发型'}}</view>
      </view>

      <view class="selection-card {{selectedScene ? 'filled' : ''}}" bindtap="openScenePicker">
        <image
          wx:if="{{selectedScene && selectedScene.cover_url}}"
          class="selection-cover"
          src="{{selectedScene.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:else class="selection-cover selection-placeholder">场景</view>
        <view class="selection-label">已选场景</view>
        <view class="selection-value">{{selectedScene ? selectedScene.name : '去选择场景'}}</view>
      </view>
    </view>
  </view>

  <view class="floating-bar">
    <button
      class="primary-button"
      loading="{{loading}}"
      disabled="{{!selectedImage || !selectedHairstyle || !selectedScene || loading}}"
      bindtap="createJob"
    >
      {{selectedImage && selectedHairstyle && selectedScene ? '开始生成' : '请先完成上传与搭配'}}
    </button>
    <view class="floating-helper">生成结果会自动保存到历史记录</view>
  </view>
</view>
