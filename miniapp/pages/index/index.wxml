<view class="screen landing-screen">
  <view class="landing-head">
    <view class="title hero-title">上传照片，开始换发</view>
    <view class="subtitle hero-subtitle">上传清晰正脸照，开始换发</view>
    <view class="assist-row">
      <button class="secondary-button assist-button" bindtap="openRecommendationFlow">AI 推荐搭配</button>
    </view>
  </view>

  <view class="panel upload-panel">
    <view wx:if="{{selectedImage}}" class="preview-shell">
      <view class="preview-card" bindtap="previewImage">
        <image class="preview-image" src="{{selectedImage}}" mode="aspectFill"></image>
        <view class="preview-badge">
          {{imagePreparing ? '处理中' : (uploadReady ? '已就绪' : (uploadPriming ? '上传中' : '已选择'))}}
        </view>
      </view>
      <view class="preview-actions">
        <button class="secondary-button compact-button" bindtap="chooseImage">重选相册</button>
        <button class="secondary-button compact-button" bindtap="takeSelfie">重新自拍</button>
      </view>
    </view>

    <view wx:else class="upload-stage" bindtap="openImageSource">
      <view class="upload-stage-frame">
        <view class="upload-stage-deco"></view>
        <view class="upload-stage-icon">+</view>
        <view class="upload-stage-title">点击上传照片</view>
        <view class="upload-stage-copy">支持 JPG、PNG 格式</view>
      </view>
    </view>

    <view
      wx:if="{{selectedImage && uploadMessage}}"
      class="upload-status {{uploadReady ? 'ready' : ((imagePreparing || uploadPriming) ? 'working' : 'idle')}}"
    >
      <view class="upload-status-text">{{uploadMessage}}</view>
      <view wx:if="{{imagePreparing || uploadPriming}}" class="upload-progress">
        <view
          class="upload-progress-fill {{imagePreparing ? 'preparing' : ''}}"
          style="width: {{imagePreparing ? 36 : uploadProgress}}%;"
        ></view>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedImage}}" class="panel recommendation-panel">
    <view class="recommendation-head">
      <view class="section-title recommendation-title">{{recommendationTitle}}</view>
      <view wx:if="{{recommendationReady}}" class="recommendation-pill">已准备</view>
    </view>
    <view class="recommendation-copy">{{recommendationSummary}}</view>
    <button
      class="secondary-button recommendation-button"
      bindtap="openRecommendationFlow"
      loading="{{recommendationLoading}}"
      disabled="{{imagePreparing}}"
    >
      {{recommendationButtonLabel}}
    </button>
  </view>

  <view wx:if="{{selectedImage}}" class="floating-bar">
    <button class="primary-button" disabled="{{imagePreparing}}" bindtap="goNextStep">
      {{continueButtonLabel}}
    </button>
    <view class="floating-helper">{{continueHelper}}</view>
  </view>
</view>
