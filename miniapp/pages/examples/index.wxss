.examples-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.loading-panel,
.hero-card,
.info-card {
  margin-top: 24rpx;
}

.loading-panel,
.info-card {
  padding: 24rpx;
}

.hero-card {
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 640rpx;
  display: block;
  background: #e2e8f0;
}

.hero-body {
  padding: 24rpx;
}

.hero-title {
  font-size: 40rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
}

.detail-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.detail-card {
  padding: 16rpx;
}

.detail-cover {
  width: 100%;
  border-radius: 24rpx;
  display: block;
  background: #e2e8f0;
}

.detail-cover-hair,
.detail-cover-scene {
  height: 300rpx;
}

.detail-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.detail-title {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.info-line {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
}

.info-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5d6670;
}
