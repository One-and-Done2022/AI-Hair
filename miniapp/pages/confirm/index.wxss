.confirm-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-step-text {
  font-size: 20rpx;
  color: #5d6670;
}

.progress-percent {
  font-size: 28rpx;
  color: #0b5ecf;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #dadddf;
  overflow: hidden;
}

.progress-fill {
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0058ba 0%, #5091ff 100%);
}

.editorial-head {
  padding: 32rpx 4rpx 24rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 580rpx;
}

.loading-panel,
.preview-panel,
.generator-panel,
.advanced-panel {
  margin-top: 24rpx;
}

.loading-panel,
.generator-panel,
.advanced-panel {
  padding: 24rpx;
}

.preview-panel {
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 540rpx;
  display: block;
  background: #e2e8f0;
}

.preview-body {
  padding: 24rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
}

.preview-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.summary-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-card {
  padding: 16rpx;
}

.summary-image {
  width: 100%;
  border-radius: 24rpx;
  display: block;
  background: #e2e8f0;
}

.summary-image-hair {
  height: 300rpx;
}

.summary-image-scene {
  height: 300rpx;
}

.summary-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.summary-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.generator-switch {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.generator-pill {
  min-width: 132rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #edf3ff;
  color: #5d6670;
  font-size: 24rpx;
  font-weight: 700;
}

.generator-pill.active {
  background: #0058ba;
  color: #ffffff;
}

.generator-pill.disabled {
  opacity: 0.42;
}

.generator-copy {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.advanced-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.advanced-toggle {
  color: #0b5ecf;
  font-size: 24rpx;
  font-weight: 700;
}

.advanced-body {
  margin-top: 22rpx;
}

.option-group + .option-group {
  margin-top: 22rpx;
}

.option-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #485260;
}

.option-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-chip {
  min-width: 108rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 88, 186, 0.12);
  background: rgba(255, 255, 255, 0.95);
  color: #4d5762;
  font-size: 24rpx;
  font-weight: 600;
}

.option-chip.active {
  border-color: rgba(0, 88, 186, 0.34);
  background: rgba(0, 88, 186, 0.1);
  color: #0058ba;
}

.floating-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(0, 88, 186, 0.1);
}
