<view class="screen recommend-screen">
  <view class="editorial-head">
    <view class="title editorial-title">AI 推荐</view>
    <view class="subtitle editorial-subtitle">基于当前照片，为你推荐更合适的发型和场景。</view>
  </view>

  <view wx:if="{{showLoadingState}}" class="panel status-panel">
    <view class="section-title status-title">正在准备推荐</view>
    <view class="status-copy">系统正在分析你的照片并匹配更适合的发型与场景。</view>
  </view>

  <view wx:if="{{showEmptyState}}" class="panel status-panel">
    <view class="section-title status-title">推荐暂不可用</view>
    <view class="status-copy">{{emptyMessage}}</view>
    <button class="secondary-button status-button" bindtap="continueFlow">继续手动选择</button>
  </view>

  <block wx:if="{{showContentState}}">
    <view class="panel source-card">
      <image wx:if="{{selectedImage}}" class="source-image" src="{{selectedImage}}" mode="aspectFill"></image>
      <view class="source-body">
        <view class="section-title source-title">已完成照片分析</view>
        <view class="source-copy">你可以先应用推荐，也可以继续手动挑选。</view>
      </view>
    </view>

    <view class="panel recommend-list-panel">
      <view class="recommend-top">
        <view class="section-title">推荐发型</view>
      </view>
      <view class="gender-switch">
        <view
          class="gender-pill {{femaleGenderClass}}"
          data-gender="female"
          bindtap="selectRecommendationGender"
        >
          女生
        </view>
        <view
          class="gender-pill {{maleGenderClass}}"
          data-gender="male"
          bindtap="selectRecommendationGender"
        >
          男生
        </view>
      </view>
      <view wx:if="{{!recommendedHairstyles.length}}" class="empty-copy">暂无发型推荐</view>
      <view class="template-grid">
        <view
          wx:for="{{recommendedHairstyles}}"
          wx:key="id"
          class="template-tile {{item.selectedClass}}"
          data-id="{{item.id}}"
          bindtap="applyRecommendedHairstyle"
        >
          <view class="tile-cover-shell">
            <image
              wx:if="{{item.cover_url}}"
              class="tile-cover tile-cover-hair"
              src="{{item.cover_url}}"
              mode="aspectFill"
              lazy-load="true"
              catchtap="previewRecommendedHairstyle"
              data-id="{{item.id}}"
            ></image>
            <view class="preview-pill" catchtap="previewRecommendedHairstyle" data-id="{{item.id}}">预览</view>
            <view class="selection-indicator {{item.selected ? 'active' : ''}}">✓</view>
          </view>
          <view class="tile-name">{{item.name}}</view>
          <view class="tile-chip-row">
            <view wx:if="{{item.category_label}}" class="tile-chip tile-chip-highlight">{{item.category_label}}</view>
            <view wx:if="{{item.style_line_label}}" class="tile-chip">{{item.style_line_label}}</view>
          </view>
          <view wx:if="{{item.reason}}" class="recommend-tile-reason">{{item.reason}}</view>
          <view class="recommend-tile-action">{{item.actionText}}</view>
        </view>
      </view>
    </view>

    <view class="panel recommend-list-panel">
      <view class="recommend-section-head">
        <view class="section-title">推荐场景</view>
      </view>
      <view wx:if="{{!recommendedScenes.length}}" class="empty-copy">暂无场景推荐</view>
      <view class="scene-list">
        <view
          wx:for="{{recommendedScenes}}"
          wx:key="id"
          class="scene-card {{item.selectedClass}}"
          data-id="{{item.id}}"
          bindtap="applyRecommendedScene"
        >
          <view class="scene-cover-shell">
            <image
              wx:if="{{item.cover_url}}"
              class="scene-cover"
              src="{{item.cover_url}}"
              mode="aspectFill"
              lazy-load="true"
              catchtap="previewRecommendedScene"
              data-id="{{item.id}}"
            ></image>
            <view class="preview-pill" catchtap="previewRecommendedScene" data-id="{{item.id}}">预览</view>
            <view class="scene-check {{item.selected ? 'active' : ''}}">✓</view>
          </view>
          <view class="scene-body">
            <view class="scene-name">{{item.name}}</view>
            <view class="scene-desc">{{item.displayDescription}}</view>
            <view wx:if="{{item.reasonNote}}" class="scene-reason-note">{{item.reasonNote}}</view>
            <view class="scene-chip-row">
              <view wx:if="{{item.style_line_label}}" class="scene-chip">{{item.style_line_label}}</view>
              <view wx:if="{{item.primaryTag}}" class="scene-chip">{{item.primaryTag}}</view>
              <view class="scene-chip scene-chip-accent">{{item.actionText}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="floating-bar">
      <button class="primary-button" bindtap="continueFlow">{{continueButtonLabel}}</button>
    </view>
  </block>
</view>
