.recommend-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.editorial-head {
  padding: 8rpx 4rpx 24rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 580rpx;
}

.status-panel,
.source-card,
.recommend-grid,
.scene-list {
  margin-top: 24rpx;
}

.status-panel {
  padding: 28rpx;
}

.status-title {
  margin-top: 4rpx;
}

.status-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.status-button {
  margin-top: 20rpx;
  width: 100%;
}

.source-card {
  overflow: hidden;
}

.source-image {
  width: 100%;
  height: 520rpx;
  display: block;
  background: #e2e8f0;
}

.source-body {
  padding: 24rpx;
}

.source-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.recommend-top,
.recommend-section-head {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.gender-switch {
  display: inline-flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #edf3ff;
}

.gender-pill {
  min-width: 96rpx;
  padding: 12rpx 18rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5d6670;
}

.gender-pill.active {
  background: #0058ba;
  color: #ffffff;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.recommend-card,
.scene-card {
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 36rpx rgba(0, 88, 186, 0.05);
}

.recommend-card.selected,
.scene-card.selected {
  box-shadow: 0 0 0 3rpx rgba(11, 94, 207, 0.18), 0 18rpx 40rpx rgba(0, 88, 186, 0.08);
}

.recommend-cover {
  width: 100%;
  display: block;
  background: #e2e8f0;
}

.recommend-cover-hair {
  height: 300rpx;
}

.recommend-name,
.scene-name {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
}

.recommend-card .recommend-name,
.recommend-card .recommend-reason,
.recommend-card .recommend-action {
  padding-left: 18rpx;
  padding-right: 18rpx;
}

.recommend-reason,
.scene-reason {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.42;
  color: #5d6670;
}

.recommend-action,
.scene-action {
  margin-top: 12rpx;
  padding-bottom: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b5ecf;
}

.scene-list {
  display: grid;
  gap: 18rpx;
}

.scene-cover {
  width: 100%;
  height: 430rpx;
  display: block;
  background: #e2e8f0;
}

.scene-body {
  padding: 20rpx 22rpx 22rpx;
}

.floating-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(0, 88, 186, 0.1);
}
