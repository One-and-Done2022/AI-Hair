.recommend-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.editorial-head {
  padding: 8rpx 4rpx 24rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 580rpx;
}

.status-panel,
.source-card,
.recommend-list-panel {
  margin-top: 24rpx;
}

.status-panel {
  padding: 28rpx;
}

.status-title {
  margin-top: 4rpx;
}

.status-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.status-button {
  margin-top: 20rpx;
  width: 100%;
}

.source-card {
  overflow: hidden;
}

.source-image {
  width: 100%;
  height: 520rpx;
  display: block;
  background: #e2e8f0;
}

.source-body {
  padding: 24rpx;
}

.source-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.recommend-top,
.recommend-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recommend-list-panel {
  padding: 24rpx;
}

.gender-switch {
  margin-top: 18rpx;
  display: inline-flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #edf3ff;
}

.gender-pill {
  min-width: 96rpx;
  padding: 12rpx 18rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #5d6670;
}

.gender-pill.active {
  background: #0058ba;
  color: #ffffff;
}

.empty-copy {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #5d6670;
}

.template-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.template-tile {
  border-radius: 30rpx;
  padding: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.05);
}

.template-tile.selected {
  box-shadow: 0 0 0 4rpx rgba(11, 94, 207, 0.2), 0 18rpx 40rpx rgba(0, 88, 186, 0.08);
}

.tile-cover-shell {
  position: relative;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  overflow: hidden;
}

.tile-cover {
  width: 100%;
  height: 392rpx;
  display: block;
  background: #ffffff;
}

.tile-cover-hair {
  background: #ffffff;
}

.preview-pill {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
  z-index: 3;
}

.selection-indicator {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(237, 241, 247, 0.96);
  color: #9aa3ad;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
}

.selection-indicator.active {
  background: #0058ba;
  color: #ffffff;
  border-color: rgba(0, 88, 186, 0.36);
}

.tile-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile-chip-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eff1f7;
  color: #4d5762;
  font-size: 20rpx;
  font-weight: 700;
}

.tile-chip-highlight {
  background: rgba(0, 88, 186, 0.1);
  color: #0b5ecf;
}

.recommend-tile-reason {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.42;
  color: #5d6670;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-tile-action {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b5ecf;
}

.scene-list {
  margin-top: 22rpx;
  display: grid;
  gap: 22rpx;
}

.scene-card {
  padding: 20rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.scene-card.selected {
  box-shadow: 0 0 0 4rpx rgba(11, 94, 207, 0.2), 0 18rpx 44rpx rgba(0, 88, 186, 0.08);
}

.scene-cover-shell {
  position: relative;
  border-radius: 26rpx;
  overflow: hidden;
}

.scene-cover {
  width: 100%;
  height: 560rpx;
  border-radius: 26rpx;
  display: block;
  background: #eff1f2;
}

.scene-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #9aa3ad;
  background: rgba(237, 241, 247, 0.96);
  border: 1rpx solid rgba(148, 163, 184, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.scene-check.active {
  color: #ffffff;
  background: rgba(0, 88, 186, 0.92);
  border-color: rgba(0, 88, 186, 0.36);
}

.scene-body {
  margin-top: 18rpx;
}

.scene-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scene-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: #4d5762;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
}

.scene-reason-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.42;
  color: #5d6670;
}

.scene-chip-row {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.scene-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eff1f7;
  color: #4d5762;
  font-size: 20rpx;
  font-weight: 700;
}

.scene-chip-accent {
  background: rgba(0, 88, 186, 0.1);
  color: #0b5ecf;
}

.floating-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(0, 88, 186, 0.1);
}
