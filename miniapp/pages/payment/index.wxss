.payment-screen {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background: #f6f8fc;
  box-sizing: border-box;
}

.payment-head {
  margin-bottom: 24rpx;
}

.payment-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #162033;
}

.payment-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6d7890;
}

.payment-panel {
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(24, 39, 75, 0.08);
}

.payment-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  gap: 20rpx;
}

.payment-label {
  font-size: 26rpx;
  color: #7b849a;
}

.payment-value {
  flex: 1;
  font-size: 28rpx;
  color: #162033;
  text-align: right;
}

.payment-value-strong {
  font-size: 36rpx;
  font-weight: 700;
  color: #0058ba;
}

.qrcode-shell {
  width: 100%;
  margin: 28rpx 0 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f9fe;
  box-sizing: border-box;
}

.qrcode-image {
  width: 100%;
  height: 520rpx;
  display: block;
}

.qrcode-placeholder {
  width: 100%;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8b94aa;
}

.payment-status {
  font-size: 28rpx;
  font-weight: 600;
  color: #162033;
  text-align: center;
}

.payment-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6d7890;
  text-align: center;
}

.payment-action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.payment-action {
  flex: 1;
}

.payment-cancel {
  margin-top: 18rpx;
  width: 100%;
  box-sizing: border-box;
}

.payment-action-danger {
  color: #c73b3b;
  background: rgba(199, 59, 59, 0.1);
}
