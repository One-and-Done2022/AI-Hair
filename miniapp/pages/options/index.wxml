<view class="screen options-screen">
  <view class="flow-nav">
    <view class="flow-nav-group">
      <view class="flow-nav-button" bindtap="goBackStep">上一步</view>
      <view class="flow-nav-button" bindtap="resetFlow">回首页</view>
    </view>
    <view class="flow-nav-caption">选择比例与高级设置</view>
  </view>

  <view class="progress-shell">
    <view class="progress-top">
      <view class="progress-step-text">第三步 / 共四步</view>
      <view class="progress-percent">75%</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill progress-fill-three-quarter"></view>
    </view>
  </view>

  <view class="editorial-head">
    <view class="title editorial-title">选择参数</view>
    <view class="subtitle editorial-subtitle">先确定发色，再按需展开专业色号与高级设置。</view>
  </view>

  <view class="summary-grid">
    <view class="panel summary-card" bindtap="goEditHairstyle">
      <image class="summary-image summary-image-hair" src="{{selectedHairstyle.cover_url}}" mode="aspectFill" lazy-load="true"></image>
      <view class="summary-meta">
        <view>
          <view class="summary-label">已选发型</view>
          <view class="summary-name">{{selectedHairstyle.name}}</view>
        </view>
        <view class="summary-link">修改</view>
      </view>
    </view>

    <view class="panel summary-card" bindtap="goEditScene">
      <image class="summary-image summary-image-scene" src="{{selectedScene.cover_url}}" mode="aspectFill" lazy-load="true"></image>
      <view class="summary-meta">
        <view>
          <view class="summary-label">已选场景</view>
          <view class="summary-name">{{selectedScene.name}}</view>
        </view>
        <view class="summary-link">修改</view>
      </view>
    </view>
  </view>

  <view class="panel hair-color-panel">
    <view class="hair-color-head">
      <view class="section-title">发色基调</view>
      <view class="hair-color-hint">{{detectedHairColorHint}}</view>
    </view>
    <view class="hair-color-grid">
      <view
        wx:for="{{hairColors}}"
        wx:key="id"
        class="hair-color-chip {{selectedHairColor && selectedHairColor.id === item.id ? 'active' : ''}}"
        data-value="{{item.id}}"
        bindtap="selectHairColorTone"
      >
        <view class="hair-color-swatch" style="background: {{item.hex}};"></view>
        <view class="hair-color-copy">
          <view class="hair-color-name">{{item.label}}</view>
          <view class="hair-color-desc">{{item.description}}</view>
        </view>
      </view>
    </view>

    <view class="professional-shell">
      <view class="professional-head" bindtap="toggleProfessionalExpand">
        <view>
          <view class="section-title">专业色号</view>
          <view class="professional-summary" wx:if="{{selectedProfessionalHairColor}}">{{selectedProfessionalHairColor.series_name}} · {{selectedProfessionalHairColor.code}}</view>
          <view class="professional-summary" wx:else>进阶筛选入口，选择后会自动同步发色基调与工艺</view>
        </view>
        <view class="advanced-toggle">{{professionalExpanded ? '收起' : '展开'}}</view>
      </view>

      <view wx:if="{{selectedProfessionalHairColor}}" class="professional-selected-card">
        <view class="professional-selected-swatch" style="background: {{selectedProfessionalHairColor.hex_estimate}};"></view>
        <view class="professional-selected-copy">
          <view class="professional-selected-title">{{selectedProfessionalHairColor.code}} · {{selectedProfessionalHairColor.series_name}}</view>
          <view class="professional-selected-note">{{selectedProfessionalHairColor.visual_note}}</view>
          <view class="professional-selected-meta">映射 {{selectedProfessionalHairColor.mapped_tone_label}}{{selectedProfessionalHairColor.mapped_technique_text ? ' · ' + selectedProfessionalHairColor.mapped_technique_text : ''}}</view>
        </view>
      </view>

      <view wx:if="{{professionalExpanded}}" class="professional-body">
        <input
          class="professional-search-input"
          type="text"
          value="{{professionalSearchKeyword}}"
          placeholder="搜索色号 / 关键词，例如 5/72、冷雾、奶茶"
          bindinput="onProfessionalSearchInput"
        />
        <scroll-view class="professional-series-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
          <view class="professional-series-row">
            <view
              wx:for="{{professionalSeries}}"
              wx:key="id"
              class="option-chip {{professionalSelectedSeries === item.id ? 'active' : ''}}"
              data-value="{{item.id}}"
              bindtap="selectProfessionalSeries"
            >
              {{item.label}}
            </view>
          </view>
        </scroll-view>

        <view wx:if="{{filteredProfessionalColors.length}}" class="professional-grid">
          <view
            wx:for="{{filteredProfessionalColors}}"
            wx:key="id"
            class="professional-card {{selectedProfessionalHairColor && selectedProfessionalHairColor.id === item.id ? 'active' : ''}}"
            data-value="{{item.id}}"
            bindtap="selectProfessionalHairColor"
          >
            <view class="professional-card-top">
              <view class="professional-card-swatch" style="background: {{item.hex_estimate}};"></view>
              <view class="professional-card-code">{{item.code}}</view>
            </view>
            <view class="professional-card-series">{{item.series_name}}</view>
            <view class="professional-card-note">{{item.visual_note}}</view>
            <view class="professional-card-meta">{{item.mapped_tone_label}}{{item.mapped_technique_text ? ' · ' + item.mapped_technique_text : ''}}</view>
          </view>
        </view>
        <view wx:else class="professional-empty">没有找到匹配的专业色号，试试换个关键词。</view>
      </view>
    </view>
  </view>

  <view class="panel hair-technique-panel">
    <view class="section-title">染发工艺</view>
    <view class="option-row technique-row">
      <view
        wx:for="{{techniqueOptions}}"
        wx:key="id"
        class="option-chip {{selectedHairTechnique && selectedHairTechnique.id === item.id ? 'active' : ''}}"
        data-value="{{item.id}}"
        bindtap="selectHairColorTechnique"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view class="panel advanced-panel">
    <view class="advanced-head" bindtap="toggleAdvanced">
      <view>
        <view class="section-title">高级设置</view>
        <view class="advanced-summary">默认返回 1 张换发预览 + 2 张场景成片</view>
      </view>
      <view class="advanced-toggle">{{advancedOpen ? '收起' : '展开'}}</view>
    </view>

    <view wx:if="{{advancedOpen}}" class="advanced-body">
      <view class="option-group">
        <view class="option-label">默认输出</view>
        <view class="option-fixed">固定返回 1 张换发预览和 2 张场景成片，清晰度统一为 2K。</view>
      </view>
      <view class="option-group">
        <view class="option-label">画幅比例</view>
        <view class="option-row">
          <view
            wx:for="{{aspectRatioOptions}}"
            wx:key="id"
            class="option-chip {{selectedAspectRatio === item.id ? 'active' : ''}}"
            data-value="{{item.id}}"
            bindtap="selectAspectRatio"
          >
            {{item.label}}
          </view>
        </view>
      </view>
      <view class="option-group">
        <view class="option-label">输出清晰度</view>
        <view class="option-fixed">固定 2K 输出</view>
      </view>
    </view>
  </view>

  <view class="floating-bar">
    <button class="primary-button" bindtap="goNext">下一步，确认生成</button>
  </view>
</view>
