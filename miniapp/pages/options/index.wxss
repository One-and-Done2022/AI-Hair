.options-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.progress-fill-three-quarter {
  width: 75%;
}

.editorial-head {
  padding: 32rpx 4rpx 20rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 560rpx;
}

.summary-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-card,
.generator-panel,
.advanced-panel {
  padding: 18rpx;
}

.summary-image {
  width: 100%;
  border-radius: 24rpx;
  display: block;
  background: #e2e8f0;
}

.summary-image-hair,
.summary-image-scene {
  height: 300rpx;
}

.summary-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.summary-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.summary-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-link {
  flex-shrink: 0;
  margin-top: 4rpx;
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
}

.generator-panel,
.advanced-panel {
  margin-top: 24rpx;
}

.generator-switch {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.generator-pill {
  min-width: 132rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #edf3ff;
  color: #5d6670;
  font-size: 24rpx;
  font-weight: 700;
}

.generator-pill.active {
  background: #0058ba;
  color: #ffffff;
}

.generator-pill.disabled {
  opacity: 0.42;
}

.generator-copy {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.advanced-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.option-fixed {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4d5762;
}

.advanced-toggle {
  color: #0b5ecf;
  font-size: 24rpx;
  font-weight: 700;
}

.advanced-body {
  margin-top: 22rpx;
}

.option-group + .option-group {
  margin-top: 22rpx;
}

.option-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #485260;
}

.option-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-chip {
  min-width: 108rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 88, 186, 0.12);
  background: rgba(255, 255, 255, 0.95);
  color: #4d5762;
  font-size: 24rpx;
  font-weight: 600;
}

.option-chip.active {
  border-color: rgba(0, 88, 186, 0.34);
  background: rgba(0, 88, 186, 0.1);
  color: #0058ba;
}
