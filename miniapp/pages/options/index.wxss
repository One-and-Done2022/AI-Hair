.options-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.progress-fill-three-quarter {
  width: 75%;
}

.editorial-head {
  padding: 32rpx 4rpx 20rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 560rpx;
}

.summary-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-card,
.hair-color-panel,
.hair-technique-panel,
.advanced-panel {
  padding: 18rpx;
}

.summary-image {
  width: 100%;
  border-radius: 24rpx;
  display: block;
  background: #e2e8f0;
}

.summary-image-hair,
.summary-image-scene {
  height: 300rpx;
}

.summary-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.summary-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.summary-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-link {
  flex-shrink: 0;
  margin-top: 4rpx;
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
}

.hair-color-panel,
.hair-technique-panel,
.advanced-panel {
  margin-top: 24rpx;
}

.hair-color-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hair-color-hint {
  max-width: 320rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #5d6670;
  text-align: right;
}

.hair-color-grid {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.hair-color-chip {
  padding: 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hair-color-chip.active,
.professional-card.active {
  border-color: rgba(0, 88, 186, 0.28);
  box-shadow: 0 14rpx 30rpx rgba(0, 88, 186, 0.08);
}

.hair-color-swatch,
.professional-selected-swatch,
.professional-card-swatch {
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 0 0 1rpx rgba(15, 23, 42, 0.08);
  flex-shrink: 0;
}

.hair-color-swatch {
  width: 56rpx;
  height: 56rpx;
}

.hair-color-copy {
  flex: 1;
  min-width: 0;
}

.hair-color-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
}

.hair-color-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #5d6670;
}

.professional-shell {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.professional-head,
.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.professional-summary,
.advanced-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5d6670;
  line-height: 1.45;
}

.professional-selected-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(244, 247, 252, 0.92);
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.professional-selected-swatch {
  width: 60rpx;
  height: 60rpx;
}

.professional-selected-copy {
  flex: 1;
  min-width: 0;
}

.professional-selected-title,
.professional-card-code {
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
}

.professional-selected-note,
.professional-card-note,
.professional-card-meta,
.professional-selected-meta,
.professional-card-series,
.professional-empty,
.option-fixed {
  font-size: 22rpx;
  line-height: 1.5;
  color: #5d6670;
}

.professional-selected-note,
.professional-selected-meta,
.professional-card-note,
.professional-card-meta,
.professional-card-series {
  margin-top: 8rpx;
}

.professional-body {
  margin-top: 20rpx;
}

.professional-search-input {
  width: 100%;
  height: 82rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(244, 247, 252, 0.92);
  font-size: 24rpx;
  color: #20242a;
  box-sizing: border-box;
}

.professional-series-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.professional-series-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 16rpx;
}

.professional-series-meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.professional-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.professional-card {
  padding: 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: rgba(255, 255, 255, 0.96);
}

.professional-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.professional-card-top-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.professional-card-swatch {
  width: 42rpx;
  height: 42rpx;
}

.professional-empty {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(244, 247, 252, 0.92);
}

.technique-row {
  margin-top: 18rpx;
}

.option-group + .option-group {
  margin-top: 22rpx;
}

.option-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #485260;
}

.option-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option-chip {
  min-width: 108rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 88, 186, 0.12);
  background: rgba(255, 255, 255, 0.95);
  color: #4d5762;
  font-size: 24rpx;
  font-weight: 600;
}

.option-chip.active {
  border-color: rgba(0, 88, 186, 0.34);
  background: rgba(0, 88, 186, 0.1);
  color: #0058ba;
}

.advanced-toggle {
  color: #0b5ecf;
  font-size: 24rpx;
  font-weight: 700;
}

.advanced-body {
  margin-top: 22rpx;
}


.professional-card-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.07);
  color: #6b7280;
  font-size: 20rpx;
  font-weight: 700;
}

.professional-card.disabled {
  border-color: rgba(15, 23, 42, 0.05);
  background: rgba(248, 250, 252, 0.96);
}


.professional-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.professional-search-row .professional-search-input {
  flex: 1;
  width: auto;
  min-width: 0;
}

.professional-search-clear {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.05);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #4d5762;
}

.professional-search-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.professional-search-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #20242a;
}

.professional-search-tip {
  flex: 1;
  font-size: 20rpx;
  line-height: 1.45;
  color: #7b8794;
  text-align: right;
}

.professional-quick-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.professional-quick-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 16rpx;
}

.professional-quick-chip {
  min-width: 108rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 247, 252, 0.95);
  color: #4d5762;
  font-size: 22rpx;
  font-weight: 600;
}


.professional-reference-row {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(244, 247, 252, 0.92);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.professional-reference-copy {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.45;
  color: #5d6670;
}

.professional-reference-button {
  flex-shrink: 0;
  min-width: 164rpx;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.1);
  color: #0058ba;
  font-size: 22rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
