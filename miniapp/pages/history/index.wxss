.works-screen {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.works-head {
  padding: 10rpx 4rpx 24rpx;
}

.works-title {
  margin-top: 16rpx;
}

.works-subtitle {
  max-width: 580rpx;
}

.works-summary {
  padding: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-chip {
  min-height: 128rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f7f9ff 0%, #eef3ff 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 20rpx;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #20242a;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.tab-strip {
  margin-top: 24rpx;
  display: flex;
  gap: 14rpx;
}

.tab-chip {
  min-width: 160rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.84);
  color: #5d6670;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 30rpx rgba(0, 88, 186, 0.04);
}

.tab-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.works-empty {
  margin-top: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
}

.empty-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5d6670;
}

.works-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.work-card {
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.06);
}

.work-cover-shell {
  position: relative;
}

.work-cover,
.work-placeholder {
  width: 100%;
  height: 304rpx;
  display: block;
  background: #eff1f2;
}

.work-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d6670;
  font-size: 22rpx;
  text-align: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.work-status {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.84);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.work-status.failed {
  background: rgba(179, 27, 37, 0.84);
}

.work-status.succeeded {
  background: rgba(0, 106, 43, 0.84);
}

.favorite-toggle {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #99a0a8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.favorite-toggle.active {
  color: #f0a51a;
}

.work-content {
  padding: 18rpx 18rpx 14rpx;
}

.work-name,
.work-scene {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.work-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
}

.work-scene {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #5d6670;
}

.work-time {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #8a9198;
}

.work-actions {
  padding: 0 18rpx 18rpx;
  display: flex;
  gap: 12rpx;
}

.ghost-action,
.ghost-action-view {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  background: #f3f6fb;
  color: #30465f;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-action::after {
  border: none;
}
