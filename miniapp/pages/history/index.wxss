.history-screen {
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.history-copy {
  padding: 12rpx 8rpx 26rpx;
}

.history-title {
  margin-top: 18rpx;
}

.history-subtitle {
  max-width: 560rpx;
}

.history-empty {
  margin-top: 8rpx;
}

.history-grid {
  display: grid;
  gap: 20rpx;
}

.history-item {
  padding: 16rpx;
}

.history-image-shell {
  position: relative;
}

.history-image,
.history-placeholder {
  width: 100%;
  height: 420rpx;
  border-radius: 26rpx;
  background: #eadfd9;
}

.history-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #8d786d;
  font-size: 24rpx;
}

.history-status {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: rgba(48, 37, 32, 0.72);
  color: #ffffff;
}

.history-status.succeeded {
  background: rgba(106, 125, 96, 0.84);
}

.history-status.failed {
  background: rgba(186, 96, 96, 0.84);
}

.history-status.preview_ready {
  background: rgba(182, 122, 105, 0.84);
}

.history-status.pending,
.history-status.processing {
  background: rgba(141, 120, 109, 0.84);
}

.history-name {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #302520;
  line-height: 1.4;
}

.history-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a08679;
}
