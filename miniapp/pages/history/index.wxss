.history-screen {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.history-head {
  padding: 10rpx 4rpx 28rpx;
}

.history-title {
  margin-top: 16rpx;
}

.history-subtitle {
  max-width: 560rpx;
}

.history-list {
  display: grid;
  gap: 22rpx;
}

.history-item {
  padding: 16rpx;
}

.history-cover-shell {
  position: relative;
}

.history-cover,
.history-placeholder {
  width: 100%;
  height: 420rpx;
  display: block;
  border-radius: 26rpx;
  background: #eff1f2;
}

.history-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #595c5d;
  font-size: 24rpx;
}

.history-status {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.82);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.history-status.failed {
  background: rgba(179, 27, 37, 0.84);
}

.history-status.succeeded {
  background: rgba(0, 106, 43, 0.84);
}

.history-name {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.38;
  font-weight: 700;
  color: #2c2f30;
}

.history-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #757778;
}
