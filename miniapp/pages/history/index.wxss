.works-screen {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.works-head {
  padding: 10rpx 4rpx 24rpx;
}

.works-title {
  margin-top: 16rpx;
}

.works-subtitle {
  max-width: 580rpx;
}

.works-summary-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.summary-inline {
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 28rpx rgba(0, 88, 186, 0.05);
  font-size: 22rpx;
  font-weight: 700;
  color: #4d5762;
}

.tab-strip {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.tab-chip {
  min-width: 160rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.84);
  color: #5d6670;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 30rpx rgba(0, 88, 186, 0.04);
}

.tab-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.works-empty {
  margin-top: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
}

.empty-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5d6670;
}

.works-grid {
  margin-top: 24rpx;
  display: grid;
  gap: 24rpx;
}

.work-card {
  border-radius: 34rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 22rpx 56rpx rgba(0, 88, 186, 0.08);
}

.work-cover-shell {
  position: relative;
}

.work-cover,
.work-placeholder {
  width: 100%;
  height: 860rpx;
  display: block;
  background: #eff1f2;
}

.work-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d6670;
  font-size: 26rpx;
  text-align: center;
  padding: 0 36rpx;
  box-sizing: border-box;
}

.work-status {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.84);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  z-index: 2;
}

.work-status.failed {
  background: rgba(179, 27, 37, 0.84);
}

.work-status.succeeded {
  background: rgba(0, 106, 43, 0.84);
}

.work-favorite-badge {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 212, 0.96);
  color: #9a6400;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  z-index: 2;
}

.work-overlay {
  position: absolute;
  inset: auto 0 0 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(18, 27, 43, 0) 0%, rgba(18, 27, 43, 0.34) 100%);
}

.work-content {
  padding: 24rpx 24rpx 26rpx;
}

.work-meta-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.work-name {
  min-width: 0;
  flex: 1;
  font-size: 31rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.work-scene {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5d6670;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.work-time {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #8a9198;
}

.work-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b5ecf;
}
