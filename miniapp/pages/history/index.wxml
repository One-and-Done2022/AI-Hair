<view class="screen works-screen">
  <view class="works-head">
    <view class="title works-title">作品</view>
    <view class="subtitle works-subtitle">长按作品卡片可收藏、保存或删除</view>
  </view>

  <view class="works-summary-line">
    <view class="summary-inline">全部 {{items.length}}</view>
    <view class="summary-inline">收藏 {{favoriteCount}}</view>
    <view class="summary-inline">完成 {{completedCount}}</view>
  </view>

  <view class="tab-strip">
    <view
      class="tab-chip {{activeTab === 'all' ? 'active' : ''}}"
      data-tab="all"
      bindtap="changeTab"
    >
      全部作品
    </view>
    <view
      class="tab-chip {{activeTab === 'favorites' ? 'active' : ''}}"
      data-tab="favorites"
      bindtap="changeTab"
    >
      收藏
    </view>
  </view>

  <view wx:if="{{visibleItems.length === 0}}" class="panel empty-state works-empty">
    <view class="empty-title">{{activeTab === 'favorites' ? '还没有收藏作品' : '还没有生成作品'}}</view>
  </view>

  <view wx:else class="works-grid">
    <view
      wx:for="{{visibleItems}}"
      wx:key="job_id"
      class="work-card"
      bindtap="openJob"
      bindlongpress="openMoreActions"
      data-job-id="{{item.job_id}}"
    >
      <view class="work-cover-shell">
        <image
          wx:if="{{item.cover_url}}"
          class="work-cover"
          src="{{item.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:else class="work-cover work-placeholder">
          {{item.status_label}}
        </view>
        <view class="work-status {{item.status}}">{{item.status_label}}</view>
        <view wx:if="{{item.isFavorite}}" class="work-favorite-badge">已收藏</view>
        <view class="work-overlay"></view>
      </view>

      <view class="work-content">
        <view class="work-meta-top">
          <view class="work-name">{{item.hairstyle_name}}</view>
          <view class="work-time">{{item.created_at_label}}</view>
        </view>
        <view class="work-scene">{{item.scene_name}}</view>
      </view>
    </view>
  </view>
</view>
