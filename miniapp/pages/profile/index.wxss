.profile-screen {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.profile-head {
  padding: 10rpx 4rpx 24rpx;
}

.profile-title {
  margin-top: 16rpx;
}

.profile-subtitle {
  max-width: 580rpx;
}

.identity-card,
.quota-card,
.provider-alert-card,
.membership-card,
.tools-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-badge {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0058ba 0%, #79a8ff 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.identity-meta {
  min-width: 0;
  flex: 1;
}

.identity-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.identity-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.identity-tag {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
}

.identity-id,
.identity-joined {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.identity-sync {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mini-link {
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
}

.mini-note {
  color: #5d6670;
  font-size: 22rpx;
  font-weight: 600;
}

.quota-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.quota-item {
  min-height: 140rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f7fb;
}

.quota-item.emphasis {
  background: linear-gradient(135deg, #edf3ff 0%, #f7faff 100%);
}

.quota-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #20242a;
}

.quota-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.quota-footnote {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #5d6670;
}

.provider-alert-card {
  background: #fff8eb;
  border: 1rpx solid rgba(245, 158, 11, 0.22);
}

.provider-alert-copy {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #7a4a00;
}

.membership-copy {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #4d5762;
}

.member-button {
  margin-top: 24rpx;
}

.member-secondary-button {
  margin-top: 16rpx;
}

.tool-list {
  margin-top: 12rpx;
}

.tool-row {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(0, 88, 186, 0.06);
}

.tool-row:last-child {
  border-bottom: none;
}

.tool-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #20242a;
}

.tool-arrow {
  font-size: 34rpx;
  color: #8a9198;
}
