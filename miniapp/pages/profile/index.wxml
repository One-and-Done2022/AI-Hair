<view class="screen profile-screen">
  <view class="profile-head">
    <view class="title profile-title">我的</view>
  </view>

  <view wx:if="{{profile}}" class="panel identity-card">
    <view class="avatar-badge">{{profile.avatar_text}}</view>
    <view class="identity-meta">
      <view class="identity-name-row">
        <view class="identity-name">{{profile.nickname}}</view>
        <view class="identity-tag">{{profile.member_status}}</view>
      </view>
      <view class="identity-id">UID {{profile.user_id}}</view>
      <view class="identity-joined">{{profile.joined_label}}</view>
      <view class="identity-sync" bindtap="syncWechatNickname">同步微信昵称</view>
    </view>
  </view>

  <view wx:if="{{profile}}" class="panel quota-card">
    <view class="card-head">
      <view class="section-title">额度信息</view>
      <view class="mini-link" bindtap="showQuotaHelp">说明</view>
    </view>
    <view class="quota-grid">
      <view class="quota-item emphasis">
        <view class="quota-value">{{profile.total_remaining}}</view>
        <view class="quota-label">总剩余次数</view>
      </view>
      <view class="quota-item">
        <view class="quota-value">{{profile.initial_free_remaining || profile.free_remaining}}</view>
        <view class="quota-label">初始免费剩余</view>
      </view>
      <view class="quota-item">
        <view class="quota-value">{{profile.ad_unlock_remaining}}</view>
        <view class="quota-label">广告可再解锁</view>
      </view>
      <view class="quota-item">
        <view class="quota-value">{{profile.paid_remaining}}</view>
        <view class="quota-label">已购剩余</view>
      </view>
      <view class="quota-item">
        <view class="quota-value">{{profile.completed_jobs}}</view>
        <view class="quota-label">完成作品</view>
      </view>
    </view>
    <view class="quota-footnote">新规则：先送 {{profile.initial_free_total || profile.free_quota_total}} 次初始免费；最多还能通过广告解锁 {{profile.reward_ad_max || 0}} 次；本月已创建 {{profile.monthly_used}} 次任务。</view>
  </view>


  <view wx:if="{{profile && purchaseItem}}" class="panel membership-card">
    <view class="card-head">
      <view class="section-title">购买生成包</view>
      <view wx:if="{{purchaseItem}}" class="mini-note">{{purchaseItem.price_label}}</view>
    </view>
    <view class="membership-copy">初始免费用完后，最多还能看 2 次广告各解锁 1 次。广告次数用完后，可继续按次购买，每次新增 1 次完整生成额度。</view>
    <button class="primary-button member-button" loading="{{purchasing}}" bindtap="purchaseOnePack">
      {{purchaseItem ? ('购买 1 次 · ' + purchaseItem.price_label) : '购买 1 次生成'}}
    </button>
    <button wx:if="{{hasActiveCreation}}" class="secondary-button member-button member-secondary-button" bindtap="continueCreation">
      继续当前创作
    </button>
  </view>

  <view wx:if="{{profile}}" class="panel tools-card">
    <view class="section-title">工具入口</view>
    <view class="tool-list">
      <view class="tool-row" bindtap="openWorks">
        <view class="tool-label">作品记录</view>
        <view class="tool-arrow">›</view>
      </view>
      <view wx:if="{{enableInternalSceneTool}}" class="tool-row" bindtap="openSceneTool">
        <view class="tool-label">场景草案工具</view>
        <view class="tool-arrow">›</view>
      </view>
      <view class="tool-row" bindtap="showComingSoon" data-label="帮助反馈">
        <view class="tool-label">帮助反馈</view>
        <view class="tool-arrow">›</view>
      </view>
      <view class="tool-row" bindtap="showComingSoon" data-label="设置">
        <view class="tool-label">设置</view>
        <view class="tool-arrow">›</view>
      </view>
      <view class="tool-row" bindtap="relogin">
        <view class="tool-label">刷新登录</view>
        <view class="tool-arrow">›</view>
      </view>
    </view>
  </view>
</view>
