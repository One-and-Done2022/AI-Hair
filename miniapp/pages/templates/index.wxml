<view class="screen">
  <view class="panel template-section">
    <view class="section-title">发型模板</view>
    <view class="subtitle">选择一个预置发型，后端会自动拼装对应提示词。</view>
    <view class="template-list">
      <view
        wx:for="{{hairstyles}}"
        wx:key="id"
        class="template-card {{selectedHairstyleId === item.id ? 'selected' : ''}}"
        bindtap="selectHairstyle"
        data-id="{{item.id}}"
      >
        <view class="template-type">HAIR</view>
        <view class="template-name">{{item.name}}</view>
        <view class="template-desc">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view class="panel template-section">
    <view class="section-title">场景模板</view>
    <view class="subtitle">选择一个背景环境，生成时会同步完成场景替换。</view>
    <view class="template-list">
      <view
        wx:for="{{scenes}}"
        wx:key="id"
        class="template-card {{selectedSceneId === item.id ? 'selected' : ''}}"
        bindtap="selectScene"
        data-id="{{item.id}}"
      >
        <view class="template-type scene">SCENE</view>
        <view class="template-name">{{item.name}}</view>
        <view class="template-desc">{{item.description}}</view>
      </view>
    </view>
  </view>

  <button class="primary-button save-button" bindtap="saveSelection">保存当前选择</button>
</view>

