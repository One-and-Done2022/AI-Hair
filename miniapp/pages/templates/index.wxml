<view class="screen selector-screen">
  <view class="panel step-hero">
    <view class="step-badge">STEP 1 / 2</view>
    <view class="section-title">先选发型</view>
    <view class="subtitle">先确定性别和发型风格，再去下一页选择最合适的场景。</view>
  </view>

  <view class="sticky-toolbar">
    <view class="panel toolbar-card">
      <view class="gender-switch">
        <view
          class="gender-pill {{selectedGender === 'male' ? 'active' : ''}}"
          bindtap="selectGender"
          data-gender="male"
        >
          男生发型
        </view>
        <view
          class="gender-pill {{selectedGender === 'female' ? 'active' : ''}}"
          bindtap="selectGender"
          data-gender="female"
        >
          女生发型
        </view>
      </view>

      <scroll-view class="style-switch" scroll-x="true" enable-flex="true" show-scrollbar="false">
        <view
          wx:for="{{styleLineOptions}}"
          wx:key="id"
          class="style-chip {{selectedStyleLine === item.id ? 'active' : ''}}"
          bindtap="selectStyleLine"
          data-style-line="{{item.id}}"
        >
          {{item.label}}
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="panel list-card">
    <view class="list-head">
      <view class="section-title">发型模板</view>
      <view class="list-meta">{{visibleHairstyles.length}} 款可选</view>
    </view>
    <view class="template-grid">
      <view
        wx:for="{{visibleHairstyles}}"
        wx:key="id"
        class="template-tile {{selectedHairstyleId === item.id ? 'selected' : ''}}"
        bindtap="selectHairstyle"
        data-id="{{item.id}}"
      >
        <view class="tile-cover-shell">
          <image
            class="tile-cover"
            src="{{item.cover_url}}"
            mode="aspectFill"
            lazy-load="true"
          ></image>
          <view wx:if="{{selectedHairstyleId === item.id}}" class="selected-check">✓</view>
        </view>
        <view class="tile-body">
          <view class="tile-meta-row">
            <view class="tile-chip type-chip">{{item.gender_label}}</view>
            <view class="tile-chip">{{item.style_line_label}}</view>
          </view>
          <view class="tile-name">{{item.name}}</view>
          <view class="tile-desc">{{item.description}}</view>
          <view wx:if="{{item.shortTags.length}}" class="tile-tag-row">
            <text wx:for="{{item.shortTags}}" wx:for-item="tag" wx:key="*this" class="tile-tag">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <button class="primary-button save-button" bindtap="goNext">下一步：选择场景</button>
</view>
