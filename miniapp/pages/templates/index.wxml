<view class="screen selector-screen">
  <view class="progress-shell">
    <view class="progress-track">
      <view class="progress-fill progress-fill-step-one"></view>
    </view>
    <view class="progress-meta">
      <view class="progress-step">STEP 1 OF 2</view>
    </view>
  </view>

  <view class="editorial-head">
    <view class="title editorial-title">步骤 1：选择风格</view>
  </view>

  <view wx:if="{{recommendation}}" class="panel insight-card">
    <view class="insight-kicker">智能推荐</view>
    <view class="insight-title">{{recommendation.face_shape.label}}</view>
    <view class="insight-summary">{{recommendation.summary}}</view>
    <view class="insight-tag-row">
      <view
        wx:for="{{recommendation.feature_tags}}"
        wx:key="*this"
        class="insight-tag"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="gender-switch">
    <view
      class="gender-pill {{selectedGender === 'female' ? 'active' : ''}}"
      bindtap="selectGender"
      data-gender="female"
    >
      女生
    </view>
    <view
      class="gender-pill {{selectedGender === 'male' ? 'active' : ''}}"
      bindtap="selectGender"
      data-gender="male"
    >
      男生
    </view>
  </view>

  <scroll-view class="style-switch" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view
      wx:for="{{styleLineOptions}}"
      wx:key="id"
      class="style-chip {{selectedStyleLine === item.id ? 'active' : ''}}"
      bindtap="selectStyleLine"
      data-style-line="{{item.id}}"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="template-grid">
    <view
      wx:for="{{visibleHairstyles}}"
      wx:key="id"
      class="template-tile {{selectedHairstyleId === item.id ? 'selected' : ''}} {{index % 2 === 1 ? 'offset' : ''}}"
      bindtap="selectHairstyle"
      data-id="{{item.id}}"
    >
      <view class="tile-cover-shell">
        <image
          class="tile-cover"
          src="{{item.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
          catchtap="previewHairstyle"
          data-id="{{item.id}}"
        ></image>
        <view class="preview-pill" catchtap="previewHairstyle" data-id="{{item.id}}">预览</view>
        <view wx:if="{{item.recommended}}" class="template-badge">推荐</view>
        <view wx:if="{{selectedHairstyleId === item.id}}" class="selected-dot">✓</view>
      </view>
      <view class="tile-name">{{item.name}}</view>
      <view class="tile-chip-row">
        <view wx:if="{{item.primaryTag}}" class="tile-chip">{{item.primaryTag}}</view>
        <view class="tile-chip">{{item.style_line_label}}</view>
        <view wx:if="{{item.recommended}}" class="tile-chip tile-chip-highlight">智能推荐</view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="primary-button" bindtap="goNext">下一步</button>
  </view>
</view>
