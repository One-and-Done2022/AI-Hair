<view class="screen selector-screen">
  <view class="flow-nav">
    <view class="flow-nav-group">
      <view class="flow-nav-button" bindtap="goBackStep">上一步</view>
      <view class="flow-nav-button" bindtap="resetFlow">回首页</view>
    </view>
    <view class="flow-nav-caption">选好发型后进入场景</view>
  </view>

  <view class="progress-shell">
    <view class="progress-top">
      <view class="progress-step-text">第一步 / 共四步</view>
      <view class="progress-percent">25%</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill progress-fill-quarter"></view>
    </view>
  </view>

  <view class="editorial-head">
    <view class="title editorial-title">选择发型</view>
    <view class="subtitle editorial-subtitle">先定发型，再去配场景和参数。</view>
  </view>

  <view class="gender-switch">
    <view
      class="gender-pill {{selectedGender === 'female' ? 'active' : ''}}"
      bindtap="selectGender"
      data-gender="female"
    >
      女生
    </view>
    <view
      class="gender-pill {{selectedGender === 'male' ? 'active' : ''}}"
      bindtap="selectGender"
      data-gender="male"
    >
      男生
    </view>
  </view>

  <scroll-view class="style-switch" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view
      wx:for="{{categoryOptions}}"
      wx:key="id"
      class="style-chip {{selectedCategoryKey === item.id ? 'active' : ''}}"
      bindtap="selectCategory"
      data-category-key="{{item.id}}"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="template-grid">
    <view
      wx:for="{{visibleHairstyles}}"
      wx:key="id"
      class="template-tile {{selectedHairstyleId === item.id ? 'selected' : ''}}"
      bindtap="selectHairstyle"
      data-id="{{item.id}}"
    >
      <view class="tile-cover-shell">
        <image
          class="tile-cover tile-cover-hair"
          src="{{item.cover_url}}"
          mode="aspectFill"
          lazy-load="true"
          catchtap="previewHairstyle"
          data-id="{{item.id}}"
        ></image>
        <view class="preview-pill" catchtap="previewHairstyle" data-id="{{item.id}}">预览</view>
        <view class="selection-indicator {{selectedHairstyleId === item.id ? 'active' : ''}}">✓</view>
      </view>
      <view class="tile-name">{{item.name}}</view>
      <view class="tile-chip-row">
        <view wx:if="{{item.category_label}}" class="tile-chip tile-chip-highlight">{{item.category_label}}</view>
        <view wx:if="{{item.style_line_label}}" class="tile-chip">{{item.style_line_label}}</view>
      </view>
    </view>
  </view>

  <view class="floating-bar">
    <button class="primary-button" bindtap="goNext">下一步，选场景</button>
  </view>
</view>
