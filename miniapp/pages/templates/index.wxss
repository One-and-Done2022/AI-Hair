.selector-screen {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.step-hero {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(circle at top right, rgba(191, 219, 254, 0.72), transparent 34%),
    linear-gradient(135deg, #eff6ff, #f8fafc);
}

.step-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.12);
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.sticky-toolbar {
  position: sticky;
  top: 18rpx;
  z-index: 6;
  margin-bottom: 20rpx;
}

.toolbar-card {
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16rpx);
}

.toolbar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.toolbar-label,
.toolbar-count {
  font-size: 22rpx;
  color: #64748b;
}

.toolbar-count {
  font-weight: 700;
}

.gender-switch {
  display: flex;
  gap: 14rpx;
}

.gender-pill {
  flex: 1;
  padding: 20rpx 20rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #475569;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.gender-pill.active {
  background: linear-gradient(135deg, #173574, #2563eb);
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(37, 99, 235, 0.18);
}

.style-switch {
  margin-top: 18rpx;
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
}

.style-chip.active {
  background: #dbeafe;
  color: #1d4ed8;
}

.current-selection-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background:
    radial-gradient(circle at top right, rgba(191, 219, 254, 0.52), transparent 34%),
    linear-gradient(135deg, #f8fbff, #eff6ff);
}

.current-selection-kicker {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.current-selection-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.current-selection-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
}

.list-card {
  padding: 28rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.list-meta {
  color: #64748b;
  font-size: 23rpx;
}

.template-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.template-tile {
  overflow: hidden;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
}

.template-tile.selected {
  border-color: #2563eb;
  background: linear-gradient(135deg, #eff6ff, #ffffff);
  box-shadow: 0 20rpx 44rpx rgba(37, 99, 235, 0.18);
  transform: translateY(-4rpx);
}

.tile-cover-shell {
  position: relative;
}

.tile-cover {
  width: 100%;
  height: 250rpx;
  display: block;
  background: #dbe4f0;
}

.selected-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.tile-body {
  padding: 18rpx;
}

.tile-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-chip {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #475569;
  font-size: 21rpx;
  font-weight: 700;
}

.type-chip {
  background: #dbeafe;
  color: #1d4ed8;
}

.tile-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
  min-height: 82rpx;
}

.tile-tag-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 21rpx;
}

.tile-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #64748b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.save-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 22rpx 52rpx rgba(15, 23, 42, 0.12);
  backdrop-filter: blur(16rpx);
}

.save-summary {
  flex: 1;
  min-width: 0;
}

.save-label {
  color: #64748b;
  font-size: 22rpx;
}

.save-value {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.save-button {
  flex: 0 0 330rpx;
  margin: 0;
}
