.selector-screen {
  padding-bottom: calc(212rpx + env(safe-area-inset-bottom));
}

.progress-fill-quarter {
  width: 25%;
}

.editorial-head {
  padding: 34rpx 6rpx 18rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 540rpx;
}

.gender-switch {
  display: inline-flex;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  border: 1rpx solid rgba(0, 88, 186, 0.08);
}

.gender-pill {
  min-width: 132rpx;
  padding: 22rpx 30rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #4d5762;
}

.gender-pill.active {
  background: linear-gradient(135deg, #0058ba 0%, #1a73e8 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(0, 88, 186, 0.18);
}

.style-switch {
  margin-top: 22rpx;
  white-space: nowrap;
}

.style-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  color: #4d5762;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 88, 186, 0.04);
}

.style-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.template-grid {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.template-tile {
  border-radius: 30rpx;
  padding: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 14rpx 32rpx rgba(0, 88, 186, 0.05);
}

.tile-cover-shell {
  position: relative;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  overflow: hidden;
}

.selected .tile-cover-shell {
  box-shadow: 0 0 0 4rpx rgba(11, 94, 207, 0.2);
}

.tile-cover {
  width: 100%;
  height: 392rpx;
  display: block;
  background: #ffffff;
}

.tile-cover-hair {
  background: #ffffff;
}

.preview-pill {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
  z-index: 3;
}

.selected-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #0058ba;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.tile-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile-chip-row {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tile-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eff1f7;
  color: #4d5762;
  font-size: 20rpx;
  font-weight: 700;
}

.tile-chip-highlight {
  background: rgba(0, 88, 186, 0.1);
  color: #0b5ecf;
}
