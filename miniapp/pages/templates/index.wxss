.template-section {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.template-list {
  margin-top: 20rpx;
}

.template-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
}

.template-card.selected {
  border-color: #2563eb;
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.12);
}

.template-type {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.template-type.scene {
  background: #dcfce7;
  color: #15803d;
}

.template-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.template-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.7;
}

.save-button {
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}

