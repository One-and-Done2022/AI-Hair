.template-section {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.gender-switch {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.gender-pill {
  flex: 1;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #475569;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.gender-pill.active {
  background: linear-gradient(135deg, #2563eb, #0f766e);
  color: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.16);
}

.template-list {
  margin-top: 20rpx;
}

.template-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
}

.template-card.selected {
  border-color: #2563eb;
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.12);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.template-type {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.template-type.scene {
  background: #dcfce7;
  color: #15803d;
}

.mini-chip {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ede9fe;
  color: #6d28d9;
  font-size: 22rpx;
  font-weight: 600;
}

.scene-chip {
  background: #ecfccb;
  color: #3f6212;
}

.template-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.template-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.7;
}

.tag-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
}

.save-button {
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}
