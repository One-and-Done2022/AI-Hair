.capture-screen {
  padding-bottom: 40rpx;
}

.capture-panel {
  padding: 18rpx;
}

.camera-shell {
  margin-top: 4rpx;
}

.camera-view,
.capture-preview {
  width: 100%;
  height: 860rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: #0f172a;
  display: block;
}

.capture-copy-block {
  margin-top: 20rpx;
}

.capture-title {
  font-size: 32rpx;
}

.capture-tip {
  margin-top: 12rpx;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.58;
}

.capture-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.half-button {
  flex: 1;
  padding: 0;
}

.shutter-button {
  margin-top: 18rpx;
  height: 100rpx;
  line-height: 1.1;
  font-size: 30rpx;
}

.permission-card {
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fff7ed, #fffbeb);
  text-align: center;
}

.permission-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.action-gap {
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}
