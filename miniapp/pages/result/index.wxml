<view class="screen result-screen">
  <view class="progress-shell">
    <view class="progress-top">
      <view class="progress-state">{{status === 'succeeded' ? '已完成' : status === 'preview_ready' ? '首图已返回' : status === 'failed' ? '生成失败' : '正在生成'}}</view>
      <view class="progress-percent">{{status === 'succeeded' ? '100%' : progressPercent + '%'}}</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{status === 'succeeded' ? 100 : progressPercent}}%;"></view>
    </view>
  </view>

  <scroll-view class="stage-strip" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view
      wx:for="{{stageSteps}}"
      wx:key="label"
      class="stage-chip {{item.state}}"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="editorial-head">
    <view wx:if="{{mediaExpired}}" class="title editorial-title">图片已过期</view>
    <view wx:elif="{{status === 'succeeded'}}" class="title editorial-title">新发型已完成</view>
    <view wx:elif="{{status === 'preview_ready'}}" class="title editorial-title">首张预览已返回</view>
    <view wx:elif="{{status === 'failed'}}" class="title editorial-title">这次生成未完成</view>
    <view wx:else class="title editorial-title">AI 正在生成</view>
  </view>

  <view class="job-card hero-card">
    <view class="hero-frame-shell">
      <view class="result-image-frame">
        <view wx:if="{{status === 'failed'}}" class="state-pane state-pane-failed">
          <view class="state-title">生成失败</view>
        </view>

        <view wx:elif="{{mediaExpired}}" class="state-pane state-pane-expired">
          <view class="state-title">图片已过期</view>
        </view>

        <block wx:elif="{{resultImageUrl}}">
          <view wx:if="{{!resultImageLoaded}}" class="result-image-skeleton">
            <view class="result-image-skeleton-text">{{imageLoadingText}}</view>
          </view>
          <image
            wx:if="{{resultImageUrl}}"
            class="result-image {{resultImageLoaded ? 'loaded' : 'hidden'}}"
            src="{{resultImageUrl}}"
            mode="aspectFill"
            bindload="handleResultImageLoad"
            bindtap="previewResult"
            data-url="{{resultImageUrl}}"
          ></image>
          <view class="result-image-overlay"></view>
          <view wx:if="{{status === 'preview_ready'}}" class="image-badge">首图预览</view>
          <view wx:elif="{{status === 'succeeded'}}" class="image-badge">系统推荐</view>
        </block>

        <view wx:else class="state-pane">
          <view class="pulse-dot"></view>
          <view class="state-title">正在生成</view>
        </view>
      </view>
    </view>

    <view wx:if="{{job}}" class="hero-meta">
      <view class="hero-meta-title">
        {{mediaExpired ? '图片与原图已按 7 天策略自动删除，当前保留生成记录' : status === 'succeeded' ? '系统为你挑出的最佳成片' : status === 'preview_ready' ? '首张预览已可先查看' : status === 'failed' ? '本次生成未完成' : '正在生成你的成片'}}
      </view>
      <view class="hero-meta-tag-row">
        <view class="hero-meta-tag">{{job.hairstyle_name || '处理中'}}</view>
        <view class="hero-meta-tag">{{job.scene_name || '处理中'}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{mediaExpired}}" class="panel pending-panel">
    <view class="pending-title">图片保留 7 天</view>
    <view class="pending-time">若需继续使用，请重新生成并尽快保存到相册</view>
  </view>

  <view wx:if="{{status !== 'succeeded' && status !== 'failed'}}" class="panel pending-panel">
    <view class="pending-title">{{progressStage}}</view>
    <view class="pending-time">已等待 {{elapsedSeconds}} 秒</view>
  </view>

  <view wx:if="{{uploadUrl && resultImageUrl}}" class="panel compare-section">
    <view class="section-title">原图对比</view>
    <view class="compare-grid">
      <view class="compare-card" bindtap="previewOriginal">
        <image class="compare-image" src="{{uploadUrl}}" mode="aspectFill" lazy-load="true"></image>
        <view class="compare-label">原图</view>
      </view>
      <view class="compare-card" bindtap="previewResult" data-url="{{resultImageUrl}}">
        <image class="compare-image" src="{{resultImageUrl}}" mode="aspectFill" lazy-load="true"></image>
        <view class="compare-label">结果</view>
      </view>
    </view>
  </view>

  <view wx:if="{{status === 'succeeded' && resultImageUrls.length}}" class="panel candidate-section">
    <view class="candidate-head">
      <view class="section-title">全部候选</view>
      <view class="candidate-count">{{resultImageUrls.length}} 张</view>
    </view>
    <view class="candidate-list">
      <view
        wx:for="{{resultImageUrls}}"
        wx:key="*this"
        class="candidate-card {{index === 0 ? 'recommended' : ''}}"
        bindtap="previewResult"
        data-url="{{item}}"
      >
        <image class="candidate-image" src="{{item}}" mode="aspectFill" lazy-load="true"></image>
        <view class="candidate-badge">{{index === 0 ? '系统推荐' : '候选 ' + (index + 1)}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{mediaExpired}}" class="action-stack">
    <button class="primary-button" bindtap="createAnother">再生成一组</button>
    <button class="secondary-button" bindtap="goHistory">返回作品页</button>
  </view>

  <view wx:elif="{{status === 'succeeded'}}" class="action-stack">
    <button class="primary-button" bindtap="saveImage">保存图片</button>
    <view class="action-row">
      <button class="secondary-button half-button" open-type="share">分享</button>
      <button class="secondary-button half-button" bindtap="createAnother">再生成一组</button>
    </view>
  </view>

  <view wx:elif="{{status === 'failed'}}" class="action-stack">
    <button class="primary-button" bindtap="createAnother">返回首页重新生成</button>
    <button class="secondary-button" bindtap="goHistory">去历史记录查看</button>
  </view>
</view>
