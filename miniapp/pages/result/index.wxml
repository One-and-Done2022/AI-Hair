<view class="screen result-screen">
  <view class="progress-shell">
    <view class="progress-top">
      <view class="progress-state">{{statusLabel}}</view>
      <view class="progress-percent">{{status === 'succeeded' ? '100%' : progressPercent + '%'}}</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{status === 'succeeded' ? 100 : progressPercent}}%;"></view>
    </view>
  </view>

  <scroll-view class="stage-strip" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view
      wx:for="{{stageSteps}}"
      wx:key="label"
      class="stage-flow-item"
    >
      <view class="stage-node {{item.state}}">
        <view class="stage-node-index">{{item.state === 'done' ? '✓' : item.index}}</view>
      </view>
      <view class="stage-label {{item.state}}">{{item.label}}</view>
      <view wx:if="{{item.showConnector}}" class="stage-arrow {{item.connectorState}}">→</view>
    </view>
  </scroll-view>

  <view class="editorial-head">
    <view wx:if="{{mediaExpired}}" class="title editorial-title">图片已过期</view>
    <view wx:elif="{{status === 'succeeded'}}" class="title editorial-title">发型预览与场景成片已完成</view>
    <view wx:elif="{{status === 'failed' && (hairPreviewUrl || resultImageUrls.length)}}" class="title editorial-title">已返回部分结果</view>
    <view wx:elif="{{hairPreviewUrl}}" class="title editorial-title">发型预览已返回</view>
    <view wx:elif="{{status === 'failed'}}" class="title editorial-title">这次生成未完成</view>
    <view wx:else class="title editorial-title">AI 正在生成</view>
  </view>

  <view class="job-card hero-card">
    <view class="hero-frame-shell">
      <view class="result-image-frame">
        <view wx:if="{{mediaExpired}}" class="state-pane state-pane-expired">
          <view class="state-title">图片已过期</view>
        </view>

        <block wx:elif="{{resultImageUrl}}">
          <view wx:if="{{!resultImageLoaded}}" class="result-image-skeleton">
            <view class="result-image-skeleton-text">{{imageLoadingText}}</view>
          </view>
          <image
            wx:if="{{resultImageUrl}}"
            class="result-image {{resultImageLoaded ? 'loaded' : 'hidden'}}"
            src="{{resultImageUrl}}"
            mode="{{resultImageDisplayMode}}"
            bindload="handleResultImageLoad"
            bindtap="previewResult"
            data-url="{{resultImageUrl}}"
          ></image>
          <view class="result-image-overlay"></view>
          <view wx:if="{{resultImageUrls.length}}" class="image-badge">
            场景成片 {{completedSceneCount}}/2
          </view>
          <view wx:elif="{{hairPreviewUrl}}" class="image-badge">仅换发型</view>
        </block>

        <view wx:elif="{{status === 'failed'}}" class="state-pane state-pane-failed">
          <view class="state-title">生成失败</view>
        </view>

        <view wx:else class="state-pane state-pane-generating">
          <view class="gen-visual">
            <view class="gen-aura gen-aura-one"></view>
            <view class="gen-aura gen-aura-two"></view>
            <view class="gen-orbit gen-orbit-one"></view>
            <view class="gen-orbit gen-orbit-two"></view>
            <view class="gen-card gen-card-main">
              <view class="gen-card-frame">
                <view class="gen-card-scan"></view>
                <view class="gen-card-glow"></view>
                <view class="gen-portrait">
                  <view class="gen-portrait-halo"></view>
                  <view class="gen-portrait-head"></view>
                  <view class="gen-portrait-body"></view>
                </view>
              </view>
            </view>
            <view class="gen-chip gen-chip-hair">发型</view>
            <view class="gen-chip gen-chip-scene">场景</view>
            <view class="gen-chip gen-chip-light">光线</view>
            <view class="gen-spark gen-spark-a"></view>
            <view class="gen-spark gen-spark-b"></view>
            <view class="gen-spark gen-spark-c"></view>
          </view>
          <view class="state-title">正在生成</view>
        </view>
      </view>
    </view>

    <view wx:if="{{resultImageUrl && !mediaExpired}}" class="hero-view-panel">
      <view class="hero-view-top">
        <view class="hero-view-copy">当前页为展示视图，点击图片可看高清大图</view>
        <view wx:if="{{resultImageSizeText}}" class="hero-view-size">原图 {{resultImageSizeText}}</view>
      </view>
      <view class="hero-view-actions">
        <view
          class="hero-view-chip {{resultImageDisplayMode === 'aspectFit' ? 'active' : ''}}"
          bindtap="setResultImageDisplayMode"
          data-mode="aspectFit"
        >完整显示</view>
        <view
          class="hero-view-chip {{resultImageDisplayMode === 'aspectFill' ? 'active' : ''}}"
          bindtap="setResultImageDisplayMode"
          data-mode="aspectFill"
        >铺满显示</view>
        <view class="hero-view-chip hero-view-chip-primary" bindtap="previewHeroResult">高清预览</view>
      </view>
    </view>

    <view wx:if="{{job}}" class="hero-meta">
      <view class="hero-meta-title">
        {{mediaExpired ? '图片与原图已按 7 天策略自动删除，当前保留生成记录' : progressHint}}
      </view>
      <view class="hero-meta-tag-row">
        <view class="hero-meta-tag">{{job.hairstyle_name || '处理中'}}</view>
        <view class="hero-meta-tag">{{job.scene_name || '处理中'}}</view>
        <view wx:if="{{job.hair_color_mode_label}}" class="hero-meta-tag">{{job.hair_color_mode_label}}</view>
        <view wx:if="{{job.hair_color_primary_label}}" class="hero-meta-tag">{{job.hair_color_primary_label}}</view>
        <view wx:if="{{job.hair_color_secondary_label}}" class="hero-meta-tag">{{job.hair_color_secondary_label}}</view>
        <view wx:if="{{job.resolution}}" class="hero-meta-tag">{{job.resolution}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{mediaExpired}}" class="panel pending-panel">
    <view class="pending-title">图片保留 7 天</view>
    <view class="pending-time">若需继续使用，请重新生成并尽快保存到相册</view>
  </view>

  <view wx:if="{{status !== 'succeeded' && status !== 'failed'}}" class="panel pending-panel">
    <view class="pending-title">{{progressStage}}</view>
    <view class="pending-time">已等待 {{elapsedSeconds}} 秒</view>
  </view>

  <view wx:if="{{uploadUrl && resultImageUrl}}" class="panel compare-section">
    <view class="section-title">原图对比</view>
    <view class="compare-grid">
      <view class="compare-card" bindtap="previewOriginal">
        <image class="compare-image" src="{{uploadUrl}}" mode="aspectFill" lazy-load="true"></image>
        <view class="compare-label">原图</view>
      </view>
      <view class="compare-card" bindtap="previewComparison">
        <image class="compare-image" src="{{resultImageUrl}}" mode="aspectFill" lazy-load="true"></image>
        <view class="compare-label">{{resultImageUrls.length ? '当前场景成片' : '当前发型预览'}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{hairPreviewUrl}}" class="panel candidate-section">
    <view class="candidate-head">
      <view class="section-title">发型预览图</view>
      <view class="candidate-count">1 张</view>
    </view>
    <view class="candidate-list">
      <view
        class="candidate-card recommended"
        bindtap="previewResult"
        data-url="{{hairPreviewUrl}}"
      >
        <image class="candidate-image candidate-image-short" src="{{hairPreviewUrl}}" mode="aspectFill" lazy-load="true"></image>
        <view class="candidate-badge">仅换发型</view>
      </view>
    </view>
  </view>

  <view wx:if="{{resultImageUrls.length}}" class="panel candidate-section">
    <view class="candidate-head">
      <view class="section-title">场景成片</view>
      <view class="candidate-count">{{resultImageUrls.length}} / 2 张</view>
    </view>
    <view class="candidate-list">
      <view
        wx:for="{{resultImageUrls}}"
        wx:key="*this"
        class="candidate-card {{index === 0 ? 'recommended' : ''}}"
        bindtap="previewResult"
        data-url="{{item}}"
      >
        <image class="candidate-image" src="{{item}}" mode="aspectFill" lazy-load="true"></image>
        <view class="candidate-badge">场景成片 {{index + 1}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{mediaExpired}}" class="action-stack">
    <button class="primary-button" bindtap="createAnother">再生成一组</button>
    <button class="secondary-button" bindtap="goHistory">返回作品页</button>
  </view>

  <view wx:elif="{{status === 'succeeded'}}" class="action-stack">
    <button class="primary-button" bindtap="saveImage">保存图片</button>
    <view class="action-row">
      <button class="secondary-button half-button" open-type="share">分享</button>
      <button class="secondary-button half-button" bindtap="createAnother">再生成一组</button>
    </view>
  </view>

  <view wx:elif="{{status === 'failed' && (hairPreviewUrl || resultImageUrls.length)}}" class="action-stack">
    <button class="primary-button" bindtap="saveImage">保存已生成图片</button>
    <button class="secondary-button" bindtap="createAnother">返回首页重新生成</button>
  </view>

  <view wx:elif="{{status === 'failed'}}" class="action-stack">
    <button class="primary-button" bindtap="createAnother">返回首页重新生成</button>
    <button class="secondary-button" bindtap="goHistory">去历史记录查看</button>
  </view>

  <view wx:if="{{feedbackVisible && feedbackPrompt}}" class="feedback-layer" catchtouchmove="noop">
    <view class="feedback-mask" catchtap="noop"></view>
    <view class="feedback-sheet" catchtap="noop">
      <view class="feedback-kicker">首次成功反馈</view>
      <view class="feedback-title">{{feedbackPrompt.title}}</view>
      <view class="feedback-copy">{{feedbackPrompt.description}}</view>
      <view class="feedback-meta">当前是你第 {{feedbackPrompt.trigger_completed_jobs}} 次成功出图后的反馈</view>

      <scroll-view class="feedback-scroll" scroll-y="true" enable-flex="true">
        <view class="feedback-question">
          <view class="feedback-question-title">1. 发型效果是否达到预期</view>
          <view class="feedback-option-row">
            <view
              wx:for="{{feedbackHairstyleOptions}}"
              wx:key="value"
              class="feedback-option {{feedbackForm.hairstyle_expectation === item.value ? 'active' : ''}}"
              data-field="hairstyle_expectation"
              data-value="{{item.value}}"
              bindtap="selectFeedbackOption"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="feedback-question">
          <view class="feedback-question-title">2. 发色是否满意</view>
          <view class="feedback-option-row">
            <view
              wx:for="{{feedbackSatisfactionOptions}}"
              wx:key="value"
              class="feedback-option {{feedbackForm.hair_color_satisfaction === item.value ? 'active' : ''}}"
              data-field="hair_color_satisfaction"
              data-value="{{item.value}}"
              bindtap="selectFeedbackOption"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="feedback-question">
          <view class="feedback-question-title">3. 场景图是否满意</view>
          <view class="feedback-option-row">
            <view
              wx:for="{{feedbackSatisfactionOptions}}"
              wx:key="value"
              class="feedback-option {{feedbackForm.scene_satisfaction === item.value ? 'active' : ''}}"
              data-field="scene_satisfaction"
              data-value="{{item.value}}"
              bindtap="selectFeedbackOption"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="feedback-question">
          <view class="feedback-question-title">4. 等待时间是否比较久</view>
          <view class="feedback-option-row">
            <view
              wx:for="{{feedbackWaitTimeOptions}}"
              wx:key="value"
              class="feedback-option {{feedbackForm.wait_time_feeling === item.value ? 'active' : ''}}"
              data-field="wait_time_feeling"
              data-value="{{item.value}}"
              bindtap="selectFeedbackOption"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="feedback-question">
          <view class="feedback-question-title">5. 出图是否清晰</view>
          <view class="feedback-option-row">
            <view
              wx:for="{{feedbackClarityOptions}}"
              wx:key="value"
              class="feedback-option {{feedbackForm.image_clarity_satisfaction === item.value ? 'active' : ''}}"
              data-field="image_clarity_satisfaction"
              data-value="{{item.value}}"
              bindtap="selectFeedbackOption"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="feedback-question">
          <view class="feedback-question-title">6. 整体界面是否好用</view>
          <view class="feedback-option-row">
            <view
              wx:for="{{feedbackUiOptions}}"
              wx:key="value"
              class="feedback-option {{feedbackForm.ui_usability === item.value ? 'active' : ''}}"
              data-field="ui_usability"
              data-value="{{item.value}}"
              bindtap="selectFeedbackOption"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="feedback-question">
          <view class="feedback-question-title">7. 你希望我们重点改进什么</view>
          <textarea
            class="feedback-textarea"
            maxlength="2000"
            placeholder="例如发型更贴合原脸型、发色更准确、等待更短、结果更稳定等"
            value="{{feedbackForm.improvement_suggestion}}"
            bindinput="handleFeedbackSuggestionInput"
          ></textarea>
          <view class="feedback-text-count">{{feedbackSuggestionLength}} / 2000</view>
        </view>
      </scroll-view>

      <view class="feedback-actions">
        <button class="feedback-secondary-button" bindtap="dismissFeedback" disabled="{{feedbackSubmitting}}">稍后再说</button>
        <button class="feedback-primary-button" bindtap="submitFeedback" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting}}">
          {{feedbackSubmitting ? '提交中...' : '提交反馈'}}
        </button>
      </view>
    </view>
  </view>
</view>
