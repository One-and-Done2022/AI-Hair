.result-screen {
  padding-bottom: calc(92rpx + env(safe-area-inset-bottom));
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-state {
  font-size: 24rpx;
  color: #0b5ecf;
  font-weight: 700;
  white-space: nowrap;
}

.progress-percent {
  font-size: 28rpx;
  color: #0b5ecf;
  font-weight: 700;
  white-space: nowrap;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #dadddf;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0058ba 0%, #5091ff 100%);
}

.stage-strip {
  margin-top: 16rpx;
  white-space: nowrap;
}

.stage-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  color: #5d6670;
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 88, 186, 0.04);
}

.stage-chip.done {
  background: rgba(11, 94, 207, 0.12);
  color: #0b5ecf;
}

.stage-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.stage-chip.failed {
  background: rgba(179, 27, 37, 0.12);
  color: #b31b25;
}

.editorial-head {
  padding: 34rpx 4rpx 24rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 580rpx;
}

.hero-card {
  padding: 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), #ffffff 100%);
  box-shadow: 0 22rpx 56rpx rgba(0, 88, 186, 0.08);
}

.hero-frame-shell {
  padding: 10rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(237, 243, 255, 0.88), rgba(255, 255, 255, 0.96));
}

.result-image-frame {
  position: relative;
  width: 100%;
  height: 940rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eff1f5 0%, #dadddf 100%);
}

.result-image-overlay {
  position: absolute;
  inset: auto 0 0 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(18, 27, 43, 0) 0%, rgba(18, 27, 43, 0.18) 100%);
  pointer-events: none;
}

.result-image,
.compare-image,
.candidate-image {
  display: block;
  width: 100%;
}

.result-image {
  height: 100%;
}

.result-image.hidden {
  opacity: 0;
}

.result-image.loaded {
  opacity: 1;
  transition: opacity 0.24s ease;
}

.result-image-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eff1f5 0%, #dadddf 100%);
}

.result-image-skeleton-text {
  font-size: 26rpx;
  color: #5d6670;
}

.image-badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.84);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.state-pane {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(180deg, rgba(245, 246, 247, 0.96), rgba(224, 227, 228, 0.98));
}

.state-pane-generating {
  background:
    radial-gradient(circle at 50% 22%, rgba(125, 177, 255, 0.34), rgba(125, 177, 255, 0) 38%),
    linear-gradient(180deg, rgba(246, 249, 255, 0.98) 0%, rgba(223, 232, 247, 0.96) 100%);
}

.state-pane-failed {
  background: linear-gradient(180deg, rgba(255, 239, 238, 0.96), rgba(251, 81, 81, 0.12));
}

.state-pane-expired {
  background: linear-gradient(180deg, rgba(244, 246, 248, 0.98), rgba(205, 212, 218, 0.78));
}

.pulse-dot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, #6c9fff 0%, #0058ba 62%, rgba(0, 88, 186, 0.08) 70%);
  box-shadow: 0 0 0 18rpx rgba(0, 88, 186, 0.08);
}

.gen-visual {
  position: relative;
  width: 430rpx;
  height: 430rpx;
}

.gen-aura,
.gen-orbit,
.gen-card,
.gen-chip,
.gen-spark {
  position: absolute;
}

.gen-aura {
  border-radius: 999rpx;
  filter: blur(18rpx);
}

.gen-aura-one {
  left: 56rpx;
  top: 52rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(96, 165, 250, 0.24);
  animation: genPulse 2.6s ease-in-out infinite;
}

.gen-aura-two {
  right: 34rpx;
  bottom: 48rpx;
  width: 156rpx;
  height: 156rpx;
  background: rgba(14, 165, 132, 0.18);
  animation: genPulse 3.2s ease-in-out infinite reverse;
}

.gen-orbit {
  left: 50%;
  top: 50%;
  border-radius: 999rpx;
  border: 2rpx solid rgba(11, 94, 207, 0.12);
  transform-origin: center;
}

.gen-orbit-one {
  width: 346rpx;
  height: 346rpx;
  margin-left: -173rpx;
  margin-top: -173rpx;
  animation: genRotate 7.2s linear infinite;
}

.gen-orbit-two {
  width: 266rpx;
  height: 266rpx;
  margin-left: -133rpx;
  margin-top: -133rpx;
  border-color: rgba(14, 165, 132, 0.12);
  animation: genRotateReverse 5.6s linear infinite;
}

.gen-card-main {
  left: 50%;
  top: 50%;
  width: 224rpx;
  height: 304rpx;
  margin-left: -112rpx;
  margin-top: -152rpx;
  animation: genFloat 3.4s ease-in-out infinite;
}

.gen-card-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(230, 237, 248, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 26rpx 58rpx rgba(0, 88, 186, 0.18);
}

.gen-card-scan {
  position: absolute;
  left: -20%;
  right: -20%;
  top: -30%;
  height: 90rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(107, 170, 255, 0.34), rgba(255, 255, 255, 0));
  transform: rotate(-8deg);
  animation: genScan 2.2s ease-in-out infinite;
}

.gen-card-glow {
  position: absolute;
  inset: auto 18rpx 18rpx 18rpx;
  height: 110rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.24) 0%, rgba(96, 165, 250, 0) 72%);
}

.gen-portrait {
  position: absolute;
  inset: 34rpx 26rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(244, 247, 251, 0.98) 0%, rgba(224, 232, 242, 0.96) 100%);
  overflow: hidden;
}

.gen-portrait-halo {
  position: absolute;
  left: 50%;
  top: 18rpx;
  width: 126rpx;
  height: 126rpx;
  margin-left: -63rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.26) 0%, rgba(96, 165, 250, 0) 72%);
}

.gen-portrait-head {
  position: absolute;
  left: 50%;
  top: 38rpx;
  width: 108rpx;
  height: 124rpx;
  margin-left: -54rpx;
  border-radius: 54rpx 54rpx 46rpx 46rpx;
  background: linear-gradient(180deg, rgba(67, 74, 87, 0.92) 0%, rgba(67, 74, 87, 0.7) 26%, rgba(226, 202, 184, 0.9) 27%, rgba(226, 202, 184, 0.98) 100%);
}

.gen-portrait-body {
  position: absolute;
  left: 50%;
  bottom: 16rpx;
  width: 148rpx;
  height: 120rpx;
  margin-left: -74rpx;
  border-radius: 80rpx 80rpx 34rpx 34rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(225, 232, 241, 0.96) 100%);
}

.gen-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #0b5ecf;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 30rpx rgba(0, 88, 186, 0.1);
  animation: genFloatChip 3.2s ease-in-out infinite;
}

.gen-chip-hair {
  left: 18rpx;
  top: 66rpx;
}

.gen-chip-scene {
  right: 12rpx;
  top: 152rpx;
  animation-delay: 0.4s;
}

.gen-chip-light {
  left: 36rpx;
  bottom: 72rpx;
  animation-delay: 0.8s;
}

.gen-spark {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(96, 165, 250, 0.86) 48%, rgba(96, 165, 250, 0) 100%);
  animation: genSpark 2.4s ease-in-out infinite;
}

.gen-spark-a {
  right: 72rpx;
  top: 64rpx;
}

.gen-spark-b {
  left: 82rpx;
  top: 184rpx;
  animation-delay: 0.8s;
}

.gen-spark-c {
  right: 108rpx;
  bottom: 76rpx;
  animation-delay: 1.2s;
}

.state-title {
  font-size: 32rpx;
  color: #20242a;
  font-weight: 700;
  white-space: nowrap;
}

@keyframes genRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes genRotateReverse {
  from {
    transform: rotate(360deg);
  }

  to {
    transform: rotate(0deg);
  }
}

@keyframes genPulse {
  0%,
  100% {
    transform: scale(0.96);
    opacity: 0.72;
  }

  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

@keyframes genFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-12rpx);
  }
}

@keyframes genFloatChip {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes genScan {
  0% {
    top: -28%;
    opacity: 0;
  }

  18% {
    opacity: 1;
  }

  50% {
    top: 46%;
    opacity: 1;
  }

  100% {
    top: 118%;
    opacity: 0;
  }
}

@keyframes genSpark {
  0%,
  100% {
    transform: scale(0.78);
    opacity: 0.38;
  }

  50% {
    transform: scale(1.28);
    opacity: 1;
  }
}

.hero-meta {
  margin-top: 20rpx;
}

.hero-meta-kicker {
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1.4rpx;
}

.hero-meta-title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  line-height: 1.32;
}

.hero-meta-tag-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.hero-meta-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 21rpx;
  font-weight: 700;
}

.hero-meta-copy {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #4d5762;
}

.pending-panel,
.compare-section,
.candidate-section,
.action-stack {
  margin-top: 24rpx;
}

.compare-section,
.candidate-section {
  padding: 24rpx;
}

.section-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.48;
  color: #5d6670;
}

.pending-panel {
  padding: 24rpx;
}

.pending-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pending-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.pending-time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.compare-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.compare-card {
  border-radius: 30rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.compare-image {
  height: 320rpx;
  background: #eff1f2;
}

.compare-label {
  padding: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
}

.candidate-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.candidate-copy {
  margin-top: 12rpx;
}

.candidate-count {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
}

.candidate-list {
  margin-top: 20rpx;
  display: grid;
  gap: 20rpx;
}

.candidate-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.candidate-card.recommended {
  border-color: rgba(11, 94, 207, 0.18);
  box-shadow: 0 22rpx 56rpx rgba(0, 88, 186, 0.12);
}

.candidate-image {
  height: 780rpx;
  background: #eff1f2;
}

.candidate-image-short {
  height: 620rpx;
}

.candidate-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(11, 94, 207, 0.88);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.action-stack .primary-button {
  height: 104rpx;
  line-height: 1.1;
  font-size: 31rpx;
}

.action-stack .secondary-button {
  height: 88rpx;
  line-height: 1.1;
}

.action-row {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.half-button {
  flex: 1;
}
