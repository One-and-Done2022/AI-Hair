.result-screen {
  padding-bottom: calc(92rpx + env(safe-area-inset-bottom));
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-state {
  font-size: 24rpx;
  color: #0b5ecf;
  font-weight: 700;
  white-space: nowrap;
}

.progress-percent {
  font-size: 28rpx;
  color: #0b5ecf;
  font-weight: 700;
  white-space: nowrap;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #dadddf;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0058ba 0%, #5091ff 100%);
}

.stage-strip {
  margin-top: 16rpx;
  white-space: nowrap;
}

.stage-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.06);
  color: #5d6670;
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(0, 88, 186, 0.04);
}

.stage-chip.done {
  background: rgba(11, 94, 207, 0.12);
  color: #0b5ecf;
}

.stage-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.stage-chip.failed {
  background: rgba(179, 27, 37, 0.12);
  color: #b31b25;
}

.editorial-head {
  padding: 34rpx 4rpx 24rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 580rpx;
}

.hero-card {
  padding: 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), #ffffff 100%);
  box-shadow: 0 22rpx 56rpx rgba(0, 88, 186, 0.08);
}

.hero-frame-shell {
  padding: 10rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(237, 243, 255, 0.88), rgba(255, 255, 255, 0.96));
}

.result-image-frame {
  position: relative;
  width: 100%;
  height: 940rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eff1f5 0%, #dadddf 100%);
}

.result-image-overlay {
  position: absolute;
  inset: auto 0 0 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(18, 27, 43, 0) 0%, rgba(18, 27, 43, 0.18) 100%);
  pointer-events: none;
}

.result-image,
.compare-image,
.candidate-image {
  display: block;
  width: 100%;
}

.result-image {
  height: 100%;
}

.result-image.hidden {
  opacity: 0;
}

.result-image.loaded {
  opacity: 1;
  transition: opacity 0.24s ease;
}

.result-image-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eff1f5 0%, #dadddf 100%);
}

.result-image-skeleton-text {
  font-size: 26rpx;
  color: #5d6670;
}

.image-badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.84);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.state-pane {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(180deg, rgba(245, 246, 247, 0.96), rgba(224, 227, 228, 0.98));
}

.state-pane-failed {
  background: linear-gradient(180deg, rgba(255, 239, 238, 0.96), rgba(251, 81, 81, 0.12));
}

.pulse-dot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, #6c9fff 0%, #0058ba 62%, rgba(0, 88, 186, 0.08) 70%);
  box-shadow: 0 0 0 18rpx rgba(0, 88, 186, 0.08);
}

.state-title {
  font-size: 32rpx;
  color: #20242a;
  font-weight: 700;
  white-space: nowrap;
}

.hero-meta {
  margin-top: 20rpx;
}

.hero-meta-kicker {
  color: #0b5ecf;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1.4rpx;
}

.hero-meta-title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
  line-height: 1.32;
}

.hero-meta-tag-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.hero-meta-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 21rpx;
  font-weight: 700;
}

.hero-meta-copy {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #4d5762;
}

.pending-panel,
.compare-section,
.candidate-section,
.action-stack {
  margin-top: 24rpx;
}

.compare-section,
.candidate-section {
  padding: 24rpx;
}

.section-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.48;
  color: #5d6670;
}

.pending-panel {
  padding: 24rpx;
}

.pending-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #20242a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pending-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #4d5762;
}

.pending-time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5d6670;
}

.compare-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.compare-card {
  border-radius: 30rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.compare-image {
  height: 320rpx;
  background: #eff1f2;
}

.compare-label {
  padding: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #20242a;
}

.candidate-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.candidate-copy {
  margin-top: 12rpx;
}

.candidate-count {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 22rpx;
  font-weight: 700;
}

.candidate-list {
  margin-top: 20rpx;
  display: grid;
  gap: 20rpx;
}

.candidate-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.05);
}

.candidate-card.recommended {
  border-color: rgba(11, 94, 207, 0.18);
  box-shadow: 0 22rpx 56rpx rgba(0, 88, 186, 0.12);
}

.candidate-image {
  height: 780rpx;
  background: #eff1f2;
}

.candidate-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(11, 94, 207, 0.88);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.action-stack .primary-button {
  height: 104rpx;
  line-height: 104rpx;
  font-size: 30rpx;
}

.action-stack .secondary-button {
  height: 88rpx;
  line-height: 88rpx;
}

.action-row {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.half-button {
  flex: 1;
}
