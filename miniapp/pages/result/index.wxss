.status-card {
  padding: 30rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #ffffff;
}

.status-card .subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.status-text {
  color: #7dd3fc;
}

.meta-group {
  margin-top: 24rpx;
  display: grid;
  gap: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.stage-panel {
  margin-top: 24rpx;
  padding: 30rpx;
}

.result-image-frame {
  position: relative;
  width: 100%;
  height: 920rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e2e8f0, #f8fafc);
}

.stage-state {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 48rpx;
}

.stage-state-waiting {
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.9), rgba(226, 232, 240, 0.96));
}

.stage-state-failed {
  background: linear-gradient(180deg, rgba(255, 241, 242, 0.96), rgba(254, 226, 226, 0.98));
}

.pulse-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, #38bdf8 0%, #2563eb 58%, rgba(37, 99, 235, 0.08) 70%);
  box-shadow: 0 0 0 18rpx rgba(37, 99, 235, 0.08);
}

.waiting-title,
.fail-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.result-image {
  width: 100%;
  height: 100%;
  display: block;
}

.result-image.hidden {
  opacity: 0;
}

.result-image.loaded {
  opacity: 1;
  transition: opacity 0.24s ease;
}

.result-image-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e2e8f0, #f8fafc);
  z-index: 1;
}

.result-image-skeleton-text {
  color: #64748b;
  font-size: 26rpx;
}

.action-gap {
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}
