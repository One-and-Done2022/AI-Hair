.result-screen {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.status-card {
  padding: 30rpx;
  background:
    radial-gradient(circle at top right, rgba(125, 211, 252, 0.34), transparent 34%),
    radial-gradient(circle at bottom left, rgba(45, 212, 191, 0.18), transparent 30%),
    linear-gradient(135deg, #14305f 0%, #1d4f9f 62%, #145f6a 100%);
  color: #ffffff;
}

.status-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.status-card .subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.status-pill {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #7dd3fc;
  font-size: 24rpx;
  font-weight: 700;
}

.meta-group {
  margin-top: 24rpx;
  display: grid;
  gap: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.status-chip-row {
  margin-top: 22rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
}

.stage-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.stage-rail {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.stage-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.stage-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
}

.stage-name {
  font-size: 20rpx;
  line-height: 1.45;
  color: #64748b;
}

.stage-step.done .stage-dot {
  background: #2563eb;
}

.stage-step.done .stage-name {
  color: #1d4ed8;
}

.stage-step.active .stage-dot {
  background: #0f766e;
  box-shadow: 0 0 0 8rpx rgba(15, 118, 110, 0.12);
}

.stage-step.active .stage-name {
  color: #0f766e;
  font-weight: 700;
}

.stage-step.failed .stage-dot {
  background: #dc2626;
}

.stage-step.failed .stage-name {
  color: #dc2626;
}

.result-image-frame {
  position: relative;
  width: 100%;
  height: 920rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e2e8f0, #f8fafc);
}

.stage-state {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 48rpx;
}

.stage-state-waiting {
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.92), rgba(226, 232, 240, 0.96));
}

.stage-state-failed {
  background: linear-gradient(180deg, rgba(255, 241, 242, 0.96), rgba(254, 226, 226, 0.98));
}

.pulse-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, #38bdf8 0%, #2563eb 58%, rgba(37, 99, 235, 0.08) 70%);
  box-shadow: 0 0 0 18rpx rgba(37, 99, 235, 0.08);
}

.waiting-title,
.fail-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.progress-card {
  width: 100%;
  margin-top: 34rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(12rpx);
  box-sizing: border-box;
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-stage {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.progress-percent {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.25);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #1d4ed8 0%, #38bdf8 100%);
  box-shadow: 0 0 18rpx rgba(37, 99, 235, 0.18);
}

.progress-meta {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.progress-hint,
.progress-elapsed {
  font-size: 22rpx;
  line-height: 1.6;
  color: #475569;
}

.result-image {
  width: 100%;
  height: 100%;
  display: block;
}

.result-image.hidden {
  opacity: 0;
}

.result-image.loaded {
  opacity: 1;
  transition: opacity 0.24s ease;
}

.result-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 2;
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  backdrop-filter: blur(10rpx);
}

.preview-badge {
  background: rgba(37, 99, 235, 0.82);
}

.final-badge {
  background: rgba(15, 23, 42, 0.82);
}

.result-image-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e2e8f0, #f8fafc);
  z-index: 1;
}

.result-image-skeleton-text {
  color: #64748b;
  font-size: 26rpx;
}

.preview-notice,
.compare-section,
.gallery-section {
  margin-top: 24rpx;
}

.preview-notice {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
  box-shadow: 0 14rpx 36rpx rgba(37, 99, 235, 0.08);
}

.preview-notice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.preview-notice-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.preview-progress-card {
  margin-top: 20rpx;
}

.trust-grid {
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.trust-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.trust-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.trust-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.gallery-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.gallery-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.gallery-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.gallery-count {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 21rpx;
  font-weight: 700;
}

.compare-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.compare-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.compare-image {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #e2e8f0;
}

.compare-label {
  padding: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.gallery-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.gallery-thumb {
  position: relative;
  display: inline-block;
  width: 250rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.gallery-thumb.recommended {
  box-shadow: 0 18rpx 36rpx rgba(37, 99, 235, 0.16);
}

.gallery-thumb-image {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #e2e8f0;
}

.gallery-thumb-rank {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.gallery-thumb-label {
  padding: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
}

.action-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.action-grid.single-column {
  grid-template-columns: 1fr;
}
