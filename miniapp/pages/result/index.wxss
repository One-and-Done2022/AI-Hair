.status-card {
  padding: 30rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #ffffff;
}

.status-card .subtitle {
  color: rgba(255, 255, 255, 0.84);
}

.status-text {
  color: #7dd3fc;
}

.meta-group {
  margin-top: 24rpx;
  display: grid;
  gap: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.stage-panel {
  margin-top: 24rpx;
  padding: 30rpx;
}

.result-image-frame {
  position: relative;
  width: 100%;
  height: 920rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e2e8f0, #f8fafc);
}

.stage-state {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 48rpx;
}

.stage-state-waiting {
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.9), rgba(226, 232, 240, 0.96));
}

.stage-state-failed {
  background: linear-gradient(180deg, rgba(255, 241, 242, 0.96), rgba(254, 226, 226, 0.98));
}

.pulse-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, #38bdf8 0%, #2563eb 58%, rgba(37, 99, 235, 0.08) 70%);
  box-shadow: 0 0 0 18rpx rgba(37, 99, 235, 0.08);
}

.waiting-title,
.fail-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.progress-card {
  width: 100%;
  margin-top: 34rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12rpx);
  box-sizing: border-box;
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-stage {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.progress-percent {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.25);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #1d4ed8 0%, #38bdf8 100%);
  box-shadow: 0 0 18rpx rgba(37, 99, 235, 0.18);
}

.progress-meta {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.progress-hint,
.progress-elapsed {
  font-size: 22rpx;
  line-height: 1.6;
  color: #475569;
}

.result-image {
  width: 100%;
  height: 100%;
  display: block;
}

.result-image.hidden {
  opacity: 0;
}

.result-image.loaded {
  opacity: 1;
  transition: opacity 0.24s ease;
}

.result-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 2;
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  backdrop-filter: blur(10rpx);
}

.preview-badge {
  background: rgba(37, 99, 235, 0.82);
}

.final-badge {
  background: rgba(15, 23, 42, 0.82);
}

.result-image-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e2e8f0, #f8fafc);
  z-index: 1;
}

.result-image-skeleton-text {
  color: #64748b;
  font-size: 26rpx;
}

.preview-notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 100%);
  box-shadow: 0 14rpx 36rpx rgba(37, 99, 235, 0.08);
}

.preview-notice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.preview-notice-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.preview-progress-card {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.82);
}

.action-gap {
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}

.gallery-section {
  margin-top: 28rpx;
}

.gallery-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.gallery-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.candidate-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.candidate-label {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #334155;
  font-size: 22rpx;
  font-weight: 700;
}

.candidate-image {
  width: 100%;
  height: 920rpx;
  margin-top: 18rpx;
  border-radius: 22rpx;
  display: block;
  background: #e2e8f0;
}
