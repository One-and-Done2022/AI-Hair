.result-screen {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-state {
  font-size: 22rpx;
  color: #0058ba;
  font-weight: 700;
  white-space: nowrap;
}

.progress-percent {
  font-size: 26rpx;
  color: #0058ba;
  font-weight: 700;
  white-space: nowrap;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  border-radius: 999rpx;
  background: #dadddf;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0058ba 0%, #5091ff 100%);
}

.stage-strip {
  margin-top: 16rpx;
  white-space: nowrap;
}

.stage-chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #757778;
  font-size: 18rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(0, 88, 186, 0.04);
}

.stage-chip.done {
  background: rgba(0, 88, 186, 0.12);
  color: #0058ba;
}

.stage-chip.active {
  background: #0058ba;
  color: #ffffff;
}

.stage-chip.failed {
  background: rgba(179, 27, 37, 0.12);
  color: #b31b25;
}

.editorial-head {
  padding: 34rpx 4rpx 22rpx;
}

.editorial-title {
  max-width: 620rpx;
}

.editorial-subtitle {
  max-width: 580rpx;
}

.hero-card {
  padding: 20rpx;
}

.result-image-frame {
  position: relative;
  width: 100%;
  height: 900rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eff1f5 0%, #dadddf 100%);
}

.result-image,
.compare-image,
.candidate-image {
  display: block;
  width: 100%;
}

.result-image {
  height: 100%;
}

.result-image.hidden {
  opacity: 0;
}

.result-image.loaded {
  opacity: 1;
  transition: opacity 0.24s ease;
}

.result-image-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #eff1f5 0%, #dadddf 100%);
}

.result-image-skeleton-text {
  font-size: 24rpx;
  color: #757778;
}

.image-badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.84);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.state-pane {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(180deg, rgba(245, 246, 247, 0.96), rgba(224, 227, 228, 0.98));
}

.state-pane-failed {
  background: linear-gradient(180deg, rgba(255, 239, 238, 0.96), rgba(251, 81, 81, 0.12));
}

.pulse-dot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, #6c9fff 0%, #0058ba 62%, rgba(0, 88, 186, 0.08) 70%);
  box-shadow: 0 0 0 18rpx rgba(0, 88, 186, 0.08);
}

.state-title {
  font-size: 30rpx;
  color: #2c2f30;
  font-weight: 700;
  white-space: nowrap;
}

.hero-meta {
  margin-top: 18rpx;
}

.hero-meta-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c2f30;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-meta-copy {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #595c5d;
}

.pending-panel,
.compare-section,
.candidate-section,
.action-stack {
  margin-top: 24rpx;
}

.pending-panel {
  padding: 24rpx;
}

.pending-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c2f30;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pending-copy {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #595c5d;
}

.pending-time {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #757778;
}

.compare-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.compare-card {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 44rpx rgba(0, 88, 186, 0.06);
}

.compare-image {
  height: 300rpx;
  background: #eff1f2;
}

.compare-label {
  padding: 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #2c2f30;
}

.candidate-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.candidate-count {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #0058ba;
  font-size: 20rpx;
  font-weight: 700;
}

.candidate-list {
  margin-top: 18rpx;
  display: grid;
  gap: 18rpx;
}

.candidate-card {
  position: relative;
  border-radius: 30rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 44rpx rgba(0, 88, 186, 0.06);
}

.candidate-card.recommended {
  box-shadow: 0 20rpx 48rpx rgba(0, 88, 186, 0.12);
}

.candidate-image {
  height: 760rpx;
  background: #eff1f2;
}

.candidate-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 88, 186, 0.84);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.action-row {
  margin-top: 14rpx;
  display: flex;
  gap: 14rpx;
}

.half-button {
  flex: 1;
}
