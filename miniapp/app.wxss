page {
  background:
    radial-gradient(circle at top, rgba(191, 219, 254, 0.22), transparent 24%),
    linear-gradient(180deg, #f8fbff 0%, #eef3fa 100%);
  color: #0f172a;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.screen {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-card,
.panel,
.job-card,
.template-card,
.history-card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.08);
}

.title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.7;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.primary-button {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0f172a, #1d4ed8 70%, #0f766e);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 18rpx 36rpx rgba(29, 78, 216, 0.18);
}

.secondary-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  border: 2rpx solid #cbd5e1;
  color: #0f172a;
  background: rgba(255, 255, 255, 0.94);
  font-size: 28rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #e0e7ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 600;
}

.muted {
  color: #64748b;
}

.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #64748b;
}
