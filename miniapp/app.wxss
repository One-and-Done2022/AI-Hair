page {
  background:
    radial-gradient(circle at top right, rgba(108, 159, 255, 0.22), transparent 26%),
    radial-gradient(circle at bottom left, rgba(216, 226, 255, 0.2), transparent 24%),
    linear-gradient(180deg, #f8f9fd 0%, #f2f5f9 100%);
  color: #2c2f30;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.panel,
.job-card,
.history-card {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 52rpx rgba(0, 88, 186, 0.08);
}

.title {
  font-size: 52rpx;
  line-height: 1.14;
  font-weight: 700;
  color: #2c2f30;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.58;
  color: #595c5d;
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  color: #0058ba;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1.6rpx;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.24;
  font-weight: 700;
  color: #2c2f30;
}

.primary-button {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #0058ba 0%, #004da4 100%);
  color: #f0f2ff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 40rpx rgba(0, 88, 186, 0.2);
}

.primary-button[disabled] {
  background: #c8d7f4;
  color: rgba(240, 242, 255, 0.88);
  box-shadow: none;
}

.secondary-button {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  border: none;
  background: #eef3fb;
  color: #0058ba;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-state {
  padding: 92rpx 44rpx;
  text-align: center;
  color: #595c5d;
}
