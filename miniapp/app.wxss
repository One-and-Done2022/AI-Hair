page {
  background:
    radial-gradient(circle at top left, rgba(238, 214, 205, 0.42), transparent 28%),
    radial-gradient(circle at bottom right, rgba(245, 232, 224, 0.68), transparent 30%),
    linear-gradient(180deg, #fbf7f4 0%, #f7f0eb 100%);
  color: #302520;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.hero-card,
.panel,
.job-card,
.template-card,
.history-card {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 24rpx 72rpx rgba(86, 66, 57, 0.08);
}

.title {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.18;
  color: #302520;
}

.subtitle {
  margin-top: 14rpx;
  color: #8d786d;
  font-size: 26rpx;
  line-height: 1.72;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #302520;
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f7ece6;
  color: #9d6f63;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.primary-button {
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8a6158 0%, #b67a69 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 20rpx 48rpx rgba(157, 111, 99, 0.26);
}

.primary-button[disabled] {
  background: #d8c9c2;
  color: rgba(255, 255, 255, 0.92);
  box-shadow: none;
}

.secondary-button {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  border: none;
  color: #5f4a42;
  background: #f6ede8;
  font-size: 28rpx;
  font-weight: 600;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f7ece6;
  color: #9d6f63;
  font-size: 22rpx;
  font-weight: 600;
}

.muted {
  color: #8d786d;
}

.empty-state {
  padding: 88rpx 44rpx;
  text-align: center;
  color: #8d786d;
}
