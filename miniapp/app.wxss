page {
  background:
    radial-gradient(circle at top right, rgba(108, 159, 255, 0.16), transparent 24%),
    radial-gradient(circle at bottom left, rgba(216, 226, 255, 0.14), transparent 22%),
    linear-gradient(180deg, #f9fbff 0%, #f4f7fb 100%);
  color: #20242a;
  font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
}

button {
  box-sizing: border-box;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  white-space: nowrap;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.panel,
.job-card,
.history-card {
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(0, 88, 186, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(0, 88, 186, 0.06);
}

.title {
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #20242a;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.52;
  font-weight: 500;
  color: #4d5762;
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  color: #0b5ecf;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1.2rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.24;
  font-weight: 700;
  color: #20242a;
}

.primary-button {
  height: 96rpx;
  line-height: 1.1;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #0058ba 0%, #004da4 100%);
  color: #ffffff;
  font-size: 30rpx;
  letter-spacing: 0.4rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 40rpx rgba(0, 88, 186, 0.2);
}

.primary-button[disabled] {
  background: #c8d7f4;
  color: rgba(240, 242, 255, 0.88);
  box-shadow: none;
}

.secondary-button {
  height: 84rpx;
  line-height: 1.1;
  border-radius: 999rpx;
  border: none;
  background: #edf3ff;
  color: #0b5ecf;
  font-size: 28rpx;
  letter-spacing: 0.2rpx;
  font-weight: 700;
}

.empty-state {
  padding: 92rpx 44rpx;
  text-align: center;
  color: #4d5762;
}
